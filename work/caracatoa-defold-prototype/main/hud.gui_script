local function add_pill(self, screen, x, y, width, height, color, z)
	local radius = height / 2
	local center = gui.new_box_node(vmath.vector3(x, y, z), vmath.vector3(width - height, height, 0))
	local left = gui.new_pie_node(vmath.vector3(x - width / 2 + radius, y, z), vmath.vector3(height, height, 0))
	local right = gui.new_pie_node(vmath.vector3(x + width / 2 - radius, y, z), vmath.vector3(height, height, 0))
	for _, node in ipairs({ center, left, right }) do
		gui.set_pivot(node, gui.PIVOT_CENTER)
		gui.set_color(node, color)
	end
	gui.set_fill_angle(left, 360)
	gui.set_fill_angle(right, 360)
	return {
		center = track_node(self, screen, center),
		left = track_node(self, screen, left),
		right = track_node(self, screen, right),
		x = x,
		y = y,
		width = width,
		height = height,
		z = z,
	}
end

local function add_medallion(self, screen, x, y, radius, color, z)
	local node = gui.new_pie_node(vmath.vector3(x, y, z), vmath.vector3(radius * 2, radius * 2, 0))
	gui.set_pivot(node, gui.PIVOT_CENTER)
	gui.set_fill_angle(node, 360)
	gui.set_color(node, color)
	return track_node(self, screen, node)
end

local function add_accent_line(self, screen, x, y, width, height, color, z)
	local node = gui.new_box_node(vmath.vector3(x, y, z), vmath.vector3(width, height, 0))
	gui.set_pivot(node, gui.PIVOT_CENTER)
	gui.set_color(node, color)
	return track_node(self, screen, node)
end

local function add_frame_rivets(self, screen, x, y, width, height, inset, radius, z)
	for _, side in ipairs({ -1, 1 }) do
		for _, vertical in ipairs({ -1, 1 }) do
			local px = x + side * (width / 2 - inset)
			local py = y + vertical * (height / 2 - inset)
			add_medallion(self, screen, px, py, radius + 0.8, COLOR_FRAME_SHADOW, z)
			add_medallion(self, screen, px, py, radius, COLOR_FRAME_HIGHLIGHT, z + 0.002)
		end
	end
end

local function add_metal_frame(self, screen, x, y, width, height, radius, z, face_color, rivets)
	local frame = { nodes = {} }
	local layers = {
		{ width + 10, height + 10, COLOR_FRAME_SHADOW, radius + 5, z },
		{ width + 7, height + 7, COLOR_FRAME_IRON, radius + 3.5, z + 0.003 },
		{ width + 4, height + 4, COLOR_FRAME_BRONZE, radius + 2, z + 0.006 },
		{ width + 2, height + 2, COLOR_FRAME_GOLD, radius + 1, z + 0.009 },
	}
	for _, layer in ipairs(layers) do
		local surface = add_round_surface(self, screen, x, y, layer[1], layer[2], layer[3], layer[5], layer[4])
		for _, node in ipairs(surface.nodes) do frame.nodes[#frame.nodes + 1] = node end
	end
	local face = add_round_surface(self, screen, x, y, width, height, face_color, z + 0.012, radius)
	if rivets then
		local inset = math.min(radius + 2, width / 4, height / 4)
		local rivet_radius = math.min(2.2, math.max(1.35, height * 0.045))
		add_frame_rivets(self, screen, x, y, width, height, inset, rivet_radius, z + 0.014)
	end
	return frame, face
end

local function add_gothic_crest(self, screen, x, y, z)
	local _, plate = add_metal_frame(self, screen, x, y, 116, 22, 10, z, COLOR_FRAME_INSET)
	for _, node in ipairs(plate.nodes) do gui.set_enabled(node, true) end
	for _, side in ipairs({ -1, 1 }) do
		add_accent_line(self, screen, x + side * 32, y, 18, 1.5, COLOR_FRAME_GOLD, z + 0.016)
		add_accent_line(self, screen, x + side * 43, y, 7, 1, COLOR_FRAME_HIGHLIGHT, z + 0.017)
		add_medallion(self, screen, x + side * 48, y, 2.2, COLOR_FRAME_GOLD, z + 0.018)
	end
	add_medallion(self, screen, x, y, 7, COLOR_FRAME_GOLD, z + 0.016)
	add_medallion(self, screen, x, y, 4.4, COLOR_BUTTON, z + 0.017)
	add_medallion(self, screen, x, y, 1.8, COLOR_FRAME_HIGHLIGHT, z + 0.018)
end

local function set_pill_width(pill, width)
	width = math.max(0, math.min(pill.width, width or 0))
	if width <= 0 then
		gui.set_enabled(pill.center, false)
		gui.set_enabled(pill.left, false)
		gui.set_enabled(pill.right, false)
		return
	end

	local left_edge = pill.x - pill.width / 2
	if width < pill.height then
		gui.set_enabled(pill.center, false)
		gui.set_enabled(pill.right, false)
		gui.set_enabled(pill.left, true)
		gui.set_size(pill.left, vmath.vector3(width, pill.height, 0))
		gui.set_position(pill.left, vmath.vector3(left_edge + width / 2, pill.y, pill.z))
		return
	end

	local radius = pill.height / 2
	gui.set_enabled(pill.center, width > pill.height)
	gui.set_enabled(pill.left, true)
	gui.set_enabled(pill.right, true)
	gui.set_size(pill.left, vmath.vector3(pill.height, pill.height, 0))
	gui.set_size(pill.right, vmath.vector3(pill.height, pill.height, 0))
	gui.set_position(pill.left, vmath.vector3(left_edge + radius, pill.y, pill.z))
	gui.set_position(pill.right, vmath.vector3(left_edge + width - radius, pill.y, pill.z))
	local center_width = width - pill.height
	if center_width > 0 then
		gui.set_size(pill.center, vmath.vector3(center_width, pill.height, 0))
		gui.set_position(pill.center, vmath.vector3(left_edge + width / 2, pill.y, pill.z))
	end
end

local function set_ratio_fill(pill, current, maximum)
	if not pill or type(current) ~= "number" or type(maximum) ~= "number" or maximum <= 0 then
		if pill then set_pill_width(pill, 0) end
		return false
	end
	local value = math.max(0, math.min(maximum, current))
	set_pill_width(pill, pill.width * value / maximum)
	return true
end

local function set_world_vitals(self, current_hp, max_hp, current_mp, max_mp)
	if type(max_hp) == "number" and max_hp > 0 then self.world_max_hp = max_hp end
	if type(max_mp) == "number" and max_mp > 0 then self.world_max_mp = max_mp end
	local hp_max = self.world_max_hp
	local mp_max = self.world_max_mp
	local hp_valid = set_ratio_fill(self.world_hp_fill, current_hp, hp_max)
	local mp_valid = set_ratio_fill(self.world_mp_fill, current_mp, mp_max)
	set_text(self, self.world_hp_value, hp_valid and string.format("%s / %s", CaracatoaProgression.format_count(math.max(0, current_hp)), CaracatoaProgression.format_count(hp_max)) or "— / —")
	set_text(self, self.world_mp_value, mp_valid and string.format("%s / %s", CaracatoaProgression.format_count(math.max(0, current_mp)), CaracatoaProgression.format_count(mp_max)) or "— / —")
end

local function set_world_target_health(self, current_hp, max_hp)
	if type(max_hp) == "number" and max_hp > 0 then self.world_target_max_hp = max_hp end
	local target_max = self.world_target_max_hp
	local valid = set_ratio_fill(self.world_target_fill, current_hp, target_max)
	set_text(self, self.world_resources, valid and string.format("HP %s / %s", CaracatoaProgression.format_count(math.max(0, current_hp)), CaracatoaProgression.format_count(target_max)) or "HP — / —")
end

local function add_world_combat_feedback(self)
	self.world_combat_feedback = {}
	self.world_combat_feedback_next = 0
	for index = 1, COMBAT_FEEDBACK_COUNT do
		local x = 640 + (index - 2) * 22
		local y = 386 + (index - 2) * 18
		local shadow = gui.new_text_node(vmath.vector3(x + 2, y - 2, 0.795), "")
		gui.set_font(shadow, "cinzel")
		gui.set_pivot(shadow, gui.PIVOT_CENTER)
		gui.set_color(shadow, COLOR_TEXT_SHADOW)
		gui.set_scale(shadow, vmath.vector3(1.24, 1.24, 1))
		gui.set_enabled(shadow, false)
		local text = gui.new_text_node(vmath.vector3(x, y, 0.8), "")
		gui.set_font(text, "cinzel")
		gui.set_pivot(text, gui.PIVOT_CENTER)
		gui.set_color(text, COLOR_COMBAT_DAMAGE)
		gui.set_scale(text, vmath.vector3(1.24, 1.24, 1))
		gui.set_enabled(text, false)
		self.text_shadow_by_node[text] = shadow
		self.world_combat_feedback[index] = {
			text = text,
			shadow = shadow,
			x = x,
			y = y,
			elapsed = COMBAT_FEEDBACK_DURATION,
			color = COLOR_COMBAT_DAMAGE,
			active = false,
		}
	end
end

local function show_world_combat_feedback(self, value, color)
	if self.screen ~= "world" or type(value) ~= "string" or value == "" then return end
	local feedback = self.world_combat_feedback
	if not feedback or #feedback == 0 then return end
	self.world_combat_feedback_next = (self.world_combat_feedback_next or 0) % #feedback + 1
	local popup = feedback[self.world_combat_feedback_next]
	set_text(self, popup.text, value)
	popup.color = color
	popup.elapsed = 0
	popup.active = true
	gui.set_position(popup.text, vmath.vector3(popup.x, popup.y, 0.8))
	gui.set_position(popup.shadow, vmath.vector3(popup.x + 2, popup.y - 2, 0.795))
	gui.set_color(popup.text, color)
	gui.set_color(popup.shadow, COLOR_TEXT_SHADOW)
	gui.set_enabled(popup.shadow, true)
	gui.set_enabled(popup.text, true)
end

local function update_world_combat_feedback(self, dt)
	for _, popup in ipairs(self.world_combat_feedback or {}) do
		if popup.active then
			popup.elapsed = popup.elapsed + dt
			if self.screen ~= "world" or popup.elapsed >= COMBAT_FEEDBACK_DURATION then
				popup.active = false
				gui.set_enabled(popup.shadow, false)
				gui.set_enabled(popup.text, false)
			else
				local progress = popup.elapsed / COMBAT_FEEDBACK_DURATION
				local alpha = 1 - progress
				local y = popup.y + COMBAT_FEEDBACK_RISE * progress
				gui.set_position(popup.text, vmath.vector3(popup.x, y, 0.8))
				gui.set_position(popup.shadow, vmath.vector3(popup.x + 2, y - 2, 0.795))
				gui.set_color(popup.text, vmath.vector4(popup.color.x, popup.color.y, popup.color.z, alpha))
				gui.set_color(popup.shadow, vmath.vector4(COLOR_TEXT_SHADOW.x, COLOR_TEXT_SHADOW.y, COLOR_TEXT_SHADOW.z, alpha))
			end
		end
	end
end

local function set_world_experience(self, experience, level)
	local progress = CaracatoaProgression.get_level_progress(experience, level)
	if not progress then
		set_pill_width(self.world_xp_fill, 0)
		set_text(self, self.world_xp_label, "EXP aguardando dados válidos do servidor")
		return false
	end
	set_pill_width(self.world_xp_fill, self.world_xp_fill.width * progress.fraction)
	local percent = math.floor(progress.fraction * 100 + 0.5)
	set_text(self, self.world_xp_label, string.format(
		"EXP %s / %s  ·  %d%%",
		CaracatoaProgression.format_count(progress.earned),
		CaracatoaProgression.format_count(progress.required),
		percent
	))
	self.world_experience = experience
	return true
end

local function add_panel(self, screen, title, subtitle, center_x)
	center_x = center_x or 270
	local left = center_x - 195
	if screen == "login" then
		add_login_panel_art(self, screen)
		return
	elseif screen == "pin" or screen == "roster" then
		add_metal_frame(self, screen, center_x, 360, 470, 590, 14, 0.09, COLOR_PANEL, true)
		add_gothic_crest(self, screen, center_x, 654, 0.12)
	else
		add_round_surface(self, screen, center_x, 360, 480, 600, COLOR_GOLD, 0.1, 16)
		add_round_surface(self, screen, center_x, 360, 470, 590, COLOR_PANEL, 0.11, 14)
	end
	add_text(self, screen, left, 608, "CARACATOA", COLOR_GOLD, false, 1.45)
	add_text(self, screen, left, 575, title, COLOR_TEXT, false, 1.15)
	add_text(self, screen, left, 546, subtitle, COLOR_MUTED)
end

local function add_framed_panel(self, screen, x, y, width, height)
	if screen == "register" then
		add_registration_panel_art(self, screen)
	else
		add_round_surface(self, screen, x, y, width, height, COLOR_GOLD, 0.1, 16)
		add_round_surface(self, screen, x, y, width - 10, height - 10, COLOR_PANEL, 0.11, 14)
	end
end

local function add_button(self, screen, action, label, x, y, width, height, z)
	local frame
	local box
	local radius = math.min(10, height / 2)
	if screen == "login" or screen == "register" then
		box = add_box(self, screen, x, y, width, height, vmath.vector4(1, 1, 1, 0))
	elseif screen == "pin" or screen == "roster" then
		frame, box = add_metal_frame(self, screen, x, y, width, height, radius, 0.105, COLOR_BUTTON, true)
		add_accent_line(self, screen, x, y + height / 2 - 5, width - 28, 1.5, vmath.vector4(0.88, 0.56, 0.30, 0.72), 0.132)
		add_accent_line(self, screen, x, y - height / 2 + 4, width - 34, 1, COLOR_FRAME_SHADOW, 0.132)
	else
		frame = add_round_surface(self, screen, x, y, width + 4, height + 4, COLOR_GOLD, z or 0.11, radius)
		box = add_round_surface(self, screen, x, y, width, height, COLOR_BUTTON, (z or 0.12) + 0.01, math.min(9, height / 2))
	end
	local text_scale = (screen == "register" or screen == "login") and 1.08 or nil
	local text = add_text(self, screen, x, y - 5, label, COLOR_TEXT, true, text_scale, z and z + 0.08 or nil)
	local register_submit = screen == "register" and action == "register_confirm"
	-- Browser CSS-to-canvas rounding puts a centered 80 ms click slightly above
	-- the submit plate. Give that button a small upward-biased hit area while
	-- keeping a one-pixel gap from the adjacent Back button.
	local button = {
		owner = self, screen = screen, action = action, box = box, frame = frame,
		text = text,
		hit_rect = {
			x = x,
			y = y + (register_submit and 2 or 0),
			width = width + 16,
			height = height + (register_submit and 8 or (screen == "register" and 2 or 10)),
		},
	}
	self.buttons[#self.buttons + 1] = button
	return button
end

local function add_field(self, screen, name, label, x, label_y, field_y, width, layer)
	local label_color = is_access_screen(screen) and COLOR_LOGIN_LABEL or COLOR_MUTED
	local label_scale = (screen == "register" or screen == "login") and 0.9 or nil
	if label and label ~= "" then
		add_text(self, screen, x - width / 2, label_y, label, label_color, false, label_scale, layer and layer + 0.08 or nil)
	end
	local frame
	local box
	if screen == "login" then
		box = add_box(self, screen, x, field_y, width, 46, vmath.vector4(1, 1, 1, 0))
	elseif screen == "register" then

	elseif screen == "pin" or screen == "roster" then
		frame, box = add_metal_frame(self, screen, x, field_y, width, 42, 9, 0.105, COLOR_FIELD, true)
		add_accent_line(self, screen, x, field_y + 42 / 2 - 5, width - 24, 1, vmath.vector4(0.79, 0.55, 0.27, 0.65), 0.132)
	else
		frame = add_round_surface(self, screen, x, field_y, width + 4, 46, COLOR_GOLD, layer or 0.11, 10)
		box = add_round_surface(self, screen, x, field_y, width, 42, COLOR_FIELD, (layer or 0.11) + 0.01, 9)
	end
	local value_scale = screen == "login" and 1.06 or (screen == "register" and 1.12 or nil)
	local value, value_effects = add_text(self, screen, x - width / 2 + (screen == "login" and 30 or 27), field_y - 5, "", COLOR_TEXT, false, value_scale, layer and layer + 0.12 or nil)
	local field = {
		screen = screen, name = name, box = box, frame = frame, value = value,
		value_effects = value_effects,
		width = width, art_backed = screen == "login" or screen == "register",
		hit_rect = { x = x, y = field_y, width = width + 14, height = 60 },
	}
	self.fields[#self.fields + 1] = field
	return field
end

local function field_for(self, name)
	for _, field in ipairs(self.fields) do
		if field.name == name and field.screen == self.screen then return field end
	end
	return nil
end

local function render_field(self, name)
	local field = field_for(self, name)
	if not field then return end
	local value = self.values[name] or ""
	local shown = value
	if name == "password" or name == "password_confirm" or name == "pin" then shown = string.rep("*", #value) end
	if shown == "" then
		local prompts = self.screen == "register" and {
			account = "ID da conta",
			password = "Senha · 8 a 11 caracteres",
			password_confirm = "Repita a senha",
			pin = "PIN · 4 a 6 dígitos",
		} or {
			account = "ID da conta",
			password = "Senha do jogo",
			password_confirm = "Repita a senha",
			pin = "Digite de 4 a 6 dígitos",
			character_name = "Nome de 1 a 16 caracteres",
			trade_target = "Nome exato da personagem",
			trade_gold = "0",
			shop_price = "Preço em gold",
		}
		shown = prompts[name] or ""
		local placeholder_color = is_access_screen(field.screen) and COLOR_LOGIN_HINT or COLOR_MUTED
		gui.set_color(field.value, field.art_backed and (self.active_field == name and COLOR_LOGIN_LABEL or placeholder_color) or placeholder_color)
	else
		gui.set_color(field.value, COLOR_TEXT)
	end
	gui.set_text(field.value, shown)
	for _, effect in ipairs(field.value_effects or {}) do gui.set_text(effect.node, shown) end
	if not field.art_backed then
		set_surface_color(field.box, self.active_field == name and COLOR_FIELD_ACTIVE or COLOR_FIELD)
	end
end

local function set_active_field(self, name)
	self.active_field = name
	for _, field in ipairs(self.fields) do render_field(self, field.name) end
end

local function refresh_creator_details(self)
	local definition = CharacterLore[self.selected_class or 0] or CharacterLore[0]
	local attributes = definition.attributes or { str = 10, int = 10, dex = 10, con = 10 }
	set_text(self, self.creator_class_title, definition.name)
	set_text(self, self.creator_class_subtitle, definition.title or "Aventureiro")
	set_text(self, self.creator_attributes, string.format(
		"INICIAIS  ·  FOR %d  |  INT %d  |  DES %d  |  CON %d",
		attributes.str, attributes.int, attributes.dex, attributes.con
	))
	set_text(self, self.creator_strengths, "FORÇAS  ·  " .. (definition.strengths or "Em definição"))
	set_text(self, self.creator_weaknesses, "LIMITES  ·  " .. (definition.weaknesses or "Em definição"))
	set_text(self, self.creator_story_title, definition.name .. " — sua história")
	set_text(self, self.creator_story_line1, definition.line1 or "A jornada começa no coração de Caracatoa.")
	set_text(self, self.creator_story_line2, definition.line2 or "")
	set_text(self, self.creator_visual, definition.visual or "")
end

local function select_creator_class(self, class_id)
	if type(class_id) ~= "number" or class_id < 0 or class_id > 3 or class_id ~= math.floor(class_id) then return end
	self.selected_class = class_id
	for _, button in ipairs(self.class_buttons) do
		set_surface_color(button.box, button.class_id == class_id and COLOR_BUTTON_SELECTED or COLOR_BUTTON)
	end
	refresh_creator_details(self)
	local avatar_urls = {
		"/transknight#avatar_animation",
		"/foema#avatar_animation",
		"/beastmaster#avatar_animation",
		"/huntress#avatar_animation",
	}
	for index, url in ipairs(avatar_urls) do
		msg.post(url, "creator_focus", { selected = index == class_id + 1 })
	end
	msg.post(avatar_urls[class_id + 1], "creator_attack")
end

local function set_status(self, text, color)
	self.status = text or ""
	if self.screen == "world" then self.status = truncate_utf8(self.status, 50) end
	if self.status_node then
		gui.set_font(self.status_node, "cinzel")
		set_text(self, self.status_node, self.status)
		gui.set_color(self.status_node, color or (is_access_screen(self.screen) and COLOR_LOGIN_LABEL or COLOR_MUTED))
	end
	if self.status_shadow_node then
		set_text(self, self.status_shadow_node, self.status)
	end
end

local function set_skill_button_enabled(button, enabled)
	if not button then return end
	enabled = enabled == true
	local owner = button.owner
	if owner then
		enabled = enabled and button.screen == owner.screen
		if button.panel then enabled = enabled and panel_is_open(owner, button.panel) end
		if enabled and button.action:sub(1, 6) == "mount_" then
			enabled = owner.mount_panel_open == true
		elseif enabled and button.action:sub(1, 6) == "trade_" then
			enabled = owner.trade_panel_open == true
		elseif enabled and button.action:sub(1, 5) == "shop_" then
			enabled = owner.shop_panel_open == true
		end
	else
		enabled = false
	end
	set_surface_enabled(button.box, enabled)
	set_surface_enabled(button.frame, enabled)
	gui.set_enabled(button.text, enabled)
	local shadow = owner and owner.text_shadow_by_node and owner.text_shadow_by_node[button.text]
	if shadow then gui.set_enabled(shadow, enabled) end
end

local function refresh_skill_panel(self)
	local skill_ids = CaracatoaSkills.by_class[self.world_class or -1] or {}
	self.world_skill_slot_ids = { skill_ids[1], skill_ids[2], skill_ids[3] }
	for slot = 1, 3 do
		local skill_id = self.world_skill_slot_ids[slot]
		local definition = skill_id and CaracatoaSkills.by_id[skill_id]
		local status_node = self.world_skill_status_nodes[slot]
		local learn_button = self.world_skill_learn_buttons[slot]
		local cast_button = self.world_skill_cast_buttons[slot]
		if not definition then
			set_text(self, status_node, slot == 1 and "Sem habilidade inicial" or "Mais habilidades em breve")
			set_text(self, learn_button.text, "Indisponível")
			set_text(self, cast_button.text, string.format("%d · —", slot))
			set_skill_button_enabled(learn_button, false)
			set_skill_button_enabled(cast_button, false)
		else
			local learned = self.world_skill_learned and self.world_skill_learned[skill_id] == true
			local target_detail = (definition.effect_type == "heal" or definition.effect_type == "defense") and "Auto" or ("Alc. " .. definition.range_tiles)
			local effect_detail = definition.effect_type == "defense" and ("+" .. tostring(definition.defense_bonus) .. " DEF") or nil
			local detail = truncate_utf8(string.format("%s · %d MP · %s", definition.name, definition.mana, effect_detail or target_detail), 34)
			if learned then
				set_text(self, status_node, truncate_utf8(detail .. " · OK", 36))
				set_text(self, learn_button.text, "Aprendida")
				set_skill_button_enabled(learn_button, false)
				set_text(self, cast_button.text, string.format("%d · %s", slot, truncate_utf8(definition.name, 10)))
				set_skill_button_enabled(cast_button, true)
			else
				local lock_reason = nil
				if (self.world_level or 1) < definition.required_level then
					lock_reason = "Nv. " .. definition.required_level
				else
					for _, prerequisite_id in ipairs(definition.prerequisites) do
						if not self.world_skill_learned or not self.world_skill_learned[prerequisite_id] then
							local prerequisite = CaracatoaSkills.by_id[prerequisite_id]
							lock_reason = prerequisite and ("Requer " .. prerequisite.name) or "Pré-requisito"
							break
						end
					end
				end
				set_text(self, status_node, truncate_utf8(detail .. (lock_reason and (" · " .. lock_reason) or " · 1 pt"), 36))
				set_text(self, learn_button.text, truncate_utf8(lock_reason or (self.world_skill_points_value > 0 and "Aprender" or "Sem pontos"), 14))
				set_skill_button_enabled(learn_button, not lock_reason and self.world_skill_points_value > 0)
				set_text(self, cast_button.text, string.format("%d · Bloq.", slot))
				set_skill_button_enabled(cast_button, false)
			end
		end
	end
	for _, button in ipairs(self.world_skill_learn_buttons or {}) do
		set_text_scale(self, button.text, 0.56)
	end
	for _, node in ipairs(self.world_skill_status_nodes or {}) do
		set_text_scale(self, node, 0.56)
	end
	set_text(self, self.world_skill_points, string.format("Pontos de habilidade: %d", self.world_skill_points_value or 0))
end

local function cast_skill_slot(self, slot)
	local skill_id = self.world_skill_slot_ids and self.world_skill_slot_ids[slot]
	if not skill_id then
		set_status(self, "Este atalho ainda não tem uma habilidade.", COLOR_GOLD)
		return false
	end
	if not self.world_skill_learned or self.world_skill_learned[skill_id] ~= true then
		set_status(self, "Aprenda esta habilidade na trilha antes de usá-la.", COLOR_GOLD)
		return false
	end
	msg.post("/local_connection#connection", "world_skill_cast", { skill_id = skill_id })
	return true
end

local MOUNT_NAMES = {
	equus = "Equus da Vigília", tigre = "Tigre das Cinzas", lobo = "Lobo do Desfiladeiro",
	grifo = "Grifo do Baluarte", hipogrifo = "Hipogrifo do Véu", pegaso = "Pégaso da Aurora",
	dragao = "Dragão Rubro", fentris = "Fentris do Eclipse",
}
local MOUNT_STAGES = { egg = "Ovo", juvenile = "Jovem", adult = "Adulto", dead = "Morta" }
local MOUNT_REASONS = {
	[1] = "A incubação ainda está em espera.", [2] = "Falta a poeira exigida no inventário.",
	[3] = "Falta Ração de Campo no inventário.", [4] = "O nível do personagem ainda é insuficiente.",
	[5] = "A montaria não atende aos requisitos dessa ação.", [6] = "O serviço de montarias está indisponível.",
	[7] = "A ação de montaria foi recusada.",
}

local function set_mount_panel_open(self, open)
	self.mount_panel_open = open == true
	for _, node in ipairs(self.mount_panel_nodes or {}) do
		gui.set_enabled(node, self.screen == "world" and self.mount_panel_open)
	end
	if self.mount_panel_toggle_button then
		set_text(self, self.mount_panel_toggle_button.text, self.mount_panel_open and "Fechar montarias" or "Montarias")
	end
end

local function trade_offer_summary(offer)
	if type(offer) ~= "table" then return "Oferta vazia" end
	local item_text = "sem item"
	if offer.itemClientId ~= nil and offer.itemClientId ~= json.null then
		local definition = CaracatoaItems.by_id[offer.itemClientId]
		item_text = definition and definition.name or ("Item #" .. tostring(offer.itemClientId))
	end
	local ready_text = offer.ready and "confirmada" or "aguardando"
	return string.format("%s  ·  %s gold  ·  %s", item_text, tostring(offer.gold or 0), ready_text)
end

local function refresh_trade_panel(self)
	if not self.world_trade_status then return end
	local state = self.world_trade_state
	local trade = state and state.trade
	local message = self.world_trade_local_message or (state and state.message) or "Convide alguém a até 5 passos para negociar."
	if trade then
		set_text(self, self.world_trade_identity, string.format("%s  ·  revisão %d  ·  %d s", trade.partnerName, trade.revision, math.ceil((trade.remainingMs or 0) / 1000)))
		set_text(self, self.world_trade_self_offer, "SUA OFERTA  " .. trade_offer_summary(trade.selfOffer))
		set_text(self, self.world_trade_partner_offer, "OFERTA DE " .. string.upper(trade.partnerName) .. "  " .. trade_offer_summary(trade.partnerOffer))
	else
		set_text(self, self.world_trade_identity, "Nenhuma negociação ativa")
		set_text(self, self.world_trade_self_offer, "SUA OFERTA  —")
		set_text(self, self.world_trade_partner_offer, "OFERTA DO OUTRO LADO  —")
	end
	if state and state.gold_balance ~= nil then
		message = message .. string.format("  ·  Saldo: %s gold", tostring(state.gold_balance))
	end
	set_text(self, self.world_trade_status, message)
	local active = trade and (trade.state == "invited" or trade.state == "offering")
	local incoming = trade and trade.state == "invited" and trade.incoming
	local offering = trade and trade.state == "offering"
	local enabled = not self.world_trade_pending
	set_skill_button_enabled(self.world_trade_invite_button, enabled and not active)
	set_skill_button_enabled(self.world_trade_accept_button, enabled and incoming)
	set_skill_button_enabled(self.world_trade_decline_button, enabled and incoming)
	set_skill_button_enabled(self.world_trade_offer_item_button, enabled and offering)
	set_skill_button_enabled(self.world_trade_offer_gold_button, enabled and offering)
	set_skill_button_enabled(self.world_trade_ready_button, enabled and offering and not trade.selfOffer.ready)
	set_skill_button_enabled(self.world_trade_cancel_button, enabled and active)
	if self.world_trade_ready_button then
		set_text(self, self.world_trade_ready_button.text, offering and trade.selfOffer.ready and "Confirmada" or "Confirmar")
	end
	if self.trade_panel_toggle_button then
		set_text(self, self.trade_panel_toggle_button.text, self.trade_panel_open and "Fechar troca" or "Negociar")
	end
end

local function set_trade_panel_open(self, open)
	self.trade_panel_open = open == true
	if self.trade_panel_open then set_mount_panel_open(self, false) end
	for _, node in ipairs(self.trade_panel_nodes or {}) do
		gui.set_enabled(node, self.screen == "world" and self.trade_panel_open)
	end
	if self.trade_panel_toggle_button then
		set_text(self, self.trade_panel_toggle_button.text, self.trade_panel_open and "Fechar troca" or "Negociar")
	end
	if not self.trade_panel_open and (self.active_field == "trade_target" or self.active_field == "trade_gold") then
		set_active_field(self, nil)
	end
	refresh_trade_panel(self)
end

local function player_shop_price(self)
	local text = self.values.shop_price or ""
	if text == "" then return nil end
	local price = tonumber(text)
	if not price or price < 1 or price > 2147483647 or price ~= math.floor(price) then return nil end
	return price
end

local function refresh_player_shop_panel(self)
	if not self.world_shop_status then return end
	local state = self.world_shop_state or {}
	local listings = state.listings or {}
	local selected_index = math.max(1, math.min(#listings, self.world_shop_selected_index or 1))
	if #listings == 0 then selected_index = 1 end
	self.world_shop_selected_index = selected_index
	local selected = listings[selected_index]
	for row = 1, 8 do
		local button = self.world_shop_rows[row]
		local listing = listings[row]
		if listing then
			local definition = CaracatoaItems.by_id[listing.clientItemId]
			local name = definition and definition.name or ("Item #" .. tostring(listing.clientItemId))
			local own = listing.own and "VOCÊ" or listing.sellerName
			local tier = listing.refinementLevel and listing.refinementLevel > 0 and (" +" .. listing.refinementLevel) or ""
			set_text(self, button.text, string.format("%s  %s%s ×%d  ·  %s gold", own, name, tier, listing.stackCount or 1, tostring(listing.askingGold)))
			set_surface_color(button.box, row == selected_index and COLOR_BUTTON_SELECTED or COLOR_BUTTON)
			set_skill_button_enabled(button, not self.world_shop_pending)
		else
			set_text(self, button.text, "—")
			set_surface_color(button.box, COLOR_FIELD)
			set_skill_button_enabled(button, false)
		end
	end
	if selected then
		local definition = CaracatoaItems.by_id[selected.clientItemId]
		local item_name = definition and definition.name or ("Item #" .. tostring(selected.clientItemId))
		local rarity = selected.rarity and string.upper(selected.rarity) or "ITEM"
		local refine = selected.refinementLevel and ("  ·  +" .. selected.refinementLevel) or ""
		set_text(self, self.world_shop_selection, string.format("%s  ·  %s%s  ·  %s gold", item_name, rarity, refine, tostring(selected.askingGold)))
		set_text(self, self.world_shop_seller, selected.own and "Anunciado por você" or ("Vendedor  ·  " .. selected.sellerName))
	else
		set_text(self, self.world_shop_selection, "Selecione um anúncio para ver os detalhes.")
		set_text(self, self.world_shop_seller, #listings == 0 and "Nenhum anúncio nesta página." or "")
	end
	local message = self.world_shop_local_message or state.message or "A feira do Bastião reúne anúncios de jogadores."
	if state.gold_balance ~= nil then message = message .. string.format("  ·  Saldo %s gold", tostring(state.gold_balance)) end
	set_text(self, self.world_shop_status, message)
	if self.world_shop_receipt then
		local receipt = self.world_shop_receipt
		local definition = CaracatoaItems.by_id[receipt.clientItemId]
		local item_name = definition and definition.name or ("Item #" .. tostring(receipt.clientItemId))
		set_text(self, self.world_shop_receipt_text, string.format("Última compra  ·  %s de %s", item_name, receipt.sellerName))
	else
		set_text(self, self.world_shop_receipt_text, "Mercado de jogadores  ·  anúncios expiram em 7 dias")
	end
	local enabled = not self.world_shop_pending
	local inventory_slot = self.world_inventory_selected_slot
	local inventory_item = inventory_slot ~= nil and self.world_inventory and self.world_inventory[inventory_slot]
	set_skill_button_enabled(self.world_shop_market_button, enabled)
	set_skill_button_enabled(self.world_shop_mine_button, enabled)
	set_skill_button_enabled(self.world_shop_refresh_button, enabled)
	set_skill_button_enabled(self.world_shop_create_button, enabled and inventory_item ~= nil and player_shop_price(self) ~= nil)
	set_skill_button_enabled(self.world_shop_buy_button, enabled and selected ~= nil and not selected.own)
	set_skill_button_enabled(self.world_shop_cancel_button, enabled and selected ~= nil and selected.own)
	if self.shop_panel_toggle_button then
		set_text(self, self.shop_panel_toggle_button.text, self.shop_panel_open and "Fechar feira" or "Feira")
	end
end

local function set_shop_panel_open(self, open)
	self.shop_panel_open = open == true
	for _, node in ipairs(self.shop_panel_nodes or {}) do
		gui.set_enabled(node, self.screen == "world" and self.shop_panel_open)
	end
	if self.shop_panel_toggle_button then
		set_text(self, self.shop_panel_toggle_button.text, self.shop_panel_open and "Fechar feira" or "Feira")
	end
	if not self.shop_panel_open and self.active_field == "shop_price" then set_active_field(self, nil) end
	refresh_player_shop_panel(self)
end

local function request_player_shop_action(self, action)
	if self.world_shop_pending then return end
	local payload = { action = action }
	if action == "create" then
		local slot = self.world_inventory_selected_slot
		local price = player_shop_price(self)
		if slot == nil or not (self.world_inventory or {})[slot] then
			self.world_shop_local_message = "Selecione no inventário o item que deseja anunciar."
			refresh_player_shop_panel(self)
			return
		end
		if not price then
			self.world_shop_local_message = "Informe um preço inteiro entre 1 e 2.147.483.647 gold."
			refresh_player_shop_panel(self)
			set_active_field(self, "shop_price")
			return
		end
		payload.inventory_slot = slot
		payload.asking_gold = price
	elseif action == "buy" or action == "cancel" then
		local listing = self.world_shop_state and self.world_shop_state.listings and self.world_shop_state.listings[self.world_shop_selected_index or 1]
		if not listing then
			self.world_shop_local_message = "Selecione um anúncio ativo."
			refresh_player_shop_panel(self)
			return
		end
		payload.listing_id = listing.listingId
	end
	self.world_shop_pending = true
	self.world_shop_local_message = "Aguardando o servidor Caracatoa confirmar a operação..."
	refresh_player_shop_panel(self)
	msg.post("/local_connection#connection", "world_shop_action", payload)
end

local function request_trade_action(self, action, offer_item)
	local state = self.world_trade_state
	local trade = state and state.trade
	local trade_id = trade and trade.tradeId or nil
	if action ~= "invite" and not trade_id then
		self.world_trade_local_message = "Não há convite ativo para esta ação."
		refresh_trade_panel(self)
		return
	end
	local payload = { action = action, trade_id = trade_id }
	if action == "invite" then
		payload.target_name = self.values.trade_target or ""
	elseif action == "offer" then
		local gold_text = self.values.trade_gold or ""
		local gold = gold_text == "" and 0 or tonumber(gold_text)
		if not gold or gold < 0 or gold > 2147483647 or gold ~= math.floor(gold) then
			self.world_trade_local_message = "Informe um valor inteiro de gold até 2.147.483.647."
			refresh_trade_panel(self)
			return
		end
		payload.inventory_slot = nil
		if offer_item and self.world_inventory_selected_slot ~= nil and self.world_inventory[self.world_inventory_selected_slot] then
			payload.inventory_slot = self.world_inventory_selected_slot
		end
		payload.gold = gold
	elseif action == "ready" then
		payload.revision = trade.revision
	end
	self.world_trade_pending = true
	self.world_trade_local_message = "Aguardando confirmação do servidor local..."
	refresh_trade_panel(self)
	msg.post("/local_connection#connection", "world_trade_action", payload)
end

local function refresh_mount_panel(self)
	if not self.mount_panel_status then return end
	local mounts = self.world_mounts or {}
	local index = math.max(1, math.min(#mounts, self.world_mount_selected_index or 1))
	self.world_mount_selected_index = index
	local mount = mounts[index]
	local inventory_slot = self.world_inventory_selected_slot
	local inventory_item = inventory_slot ~= nil and self.world_inventory and self.world_inventory[inventory_slot]
	local item_definition = inventory_item and CaracatoaItems.by_id[inventory_item.client_item_id]
	local item_name = item_definition and item_definition.name or "nenhum"
	local can_use = mount ~= nil and mount.stage ~= "egg" and mount.stage ~= "dead"
	local level = self.world_level or 1
	local ready = self.world_mount_snapshot_ready == true
	local pending = self.world_mount_pending == true
	if not mount then
		set_text(self, self.world_mount_name, "Nenhuma montaria registrada")
		set_text(self, self.world_mount_stage, ready and "O servidor ainda não entregou um ovo." or "Aguardando dados do servidor local.")
		set_text(self, self.world_mount_requirement, "Nível requerido: —")
		set_text(self, self.world_mount_hunger, "Fome: —")
		set_text(self, self.world_mount_vitality, "Vida: —")
		set_text(self, self.world_mount_bonuses, "Bônus ativos: —")
		set_text(self, self.world_mount_wait, "Selecione uma montaria para ver o ciclo de vida.")
	else
		set_text(self, self.world_mount_name, string.format("%s  ·  %d/%d", MOUNT_NAMES[mount.species_id] or mount.species_id, index, #mounts))
		set_text(self, self.world_mount_stage, string.format("%s  ·  nível %d  ·  EXP %d", MOUNT_STAGES[mount.stage] or mount.stage, mount.level, mount.experience))
		set_text(self, self.world_mount_requirement, string.format("Nível requerido: %d  ·  seu nível: %d", mount.required_level, level))
		set_text(self, self.world_mount_hunger, string.format("Fome  %d / %d", mount.hunger, mount.max_hunger))
		set_text(self, self.world_mount_vitality, string.format("Vida  %d / %d", mount.vitality, mount.max_vitality))
		local bonus = mount.bonuses or {}
		set_text(self, self.world_mount_bonuses, string.format(
			"HP +%d  ATQ +%d  MAG +%d  DEF +%d  MOV +%.2f%%  ABS +%.2f%%",
			bonus.hp or 0, bonus.physical_attack or 0, bonus.magic_attack or 0, bonus.defense or 0,
			(bonus.move_speed_bps or 0) / 100, (bonus.absorption_bps or 0) / 100))
		set_text(self, self.world_mount_wait, mount.stage == "egg"
			and string.format("Incubações restantes: %d  ·  espera: %d s", mount.incubation_remaining or 0, math.ceil((mount.incubation_wait_ms or 0) / 1000))
			or (mount.riding and "Montada  ·  a fome é consumida enquanto você está no mundo." or (mount.active and "Selecionada  ·  pronta para montar." or "A montaria precisa ser selecionada antes de montar.")))
	end
	local result_text = "Dados carregados do servidor local."
	if self.world_mount_status_result then
		local result = self.world_mount_status_result
		if result.status == 1 then result_text = "Ação confirmada e salva pelo servidor."
		elseif result.status == 2 then result_text = MOUNT_REASONS[result.reason] or "O servidor recusou a ação."
		elseif result.status == 3 then result_text = MOUNT_REASONS[result.reason] or "A incubação ainda está em espera."
		elseif result.status == 4 then result_text = MOUNT_REASONS[result.reason] or "Material necessário não encontrado."
		end
	end
	set_text(self, self.world_mount_status, result_text)
	set_text(self, self.world_mount_material, string.format("Material no slot selecionado: %s%s", item_name, inventory_slot ~= nil and (" (#" .. tostring(inventory_slot + 1) .. ")") or ""))
	local item_action_ready = ready and not pending and inventory_slot ~= nil and inventory_item ~= nil
	set_skill_button_enabled(self.world_mount_incubate_button, item_action_ready and mount and mount.stage == "egg")
	set_skill_button_enabled(self.world_mount_feed_button, item_action_ready and can_use and mount.hunger < mount.max_hunger)
	set_skill_button_enabled(self.world_mount_evolve_button, item_action_ready and mount and mount.stage == "juvenile" and mount.level >= 10)
	set_skill_button_enabled(self.world_mount_select_button, ready and not pending and can_use and not mount.active and level >= (mount.required_level or 400))
	set_skill_button_enabled(self.world_mount_ride_button, ready and not pending and can_use and
		((mount.riding == true) or (mount.active == true and mount.hunger > 0 and mount.vitality > 0 and level >= (mount.required_level or 400))))
	set_text(self, self.world_mount_select_button.text, mount and mount.active and "Selecionada" or "Selecionar")
	set_text(self, self.world_mount_ride_button.text, mount and mount.riding and "Desmontar" or "Montar")
	for _, button in ipairs({ self.world_mount_incubate_button, self.world_mount_feed_button, self.world_mount_evolve_button,
		self.world_mount_select_button, self.world_mount_ride_button }) do
		if pending then set_skill_button_enabled(button, false) end
	end
	set_skill_button_enabled(self.world_mount_previous_button, ready and #mounts > 1)
	set_skill_button_enabled(self.world_mount_next_button, ready and #mounts > 1)
	set_skill_button_enabled(self.world_mount_refresh_button, not pending)
end

local function set_screen(self, screen)
	self.screen = screen
	set_access_idle_throttle(self)
	print("[Caracatoa HUD] tela=" .. tostring(screen))
	for name, nodes in pairs(self.screen_nodes) do
		local visible = name == screen
		for _, node in ipairs(nodes) do gui.set_enabled(node, visible) end
	end
	if self.mount_panel_nodes then set_mount_panel_open(self, screen == "world" and self.mount_panel_open == true) end
	if self.trade_panel_nodes then set_trade_panel_open(self, screen == "world" and self.trade_panel_open == true) end
	if screen == "create" then
		msg.post("/transknight#movement", "creator_show")
	elseif screen == "login" or screen == "register" then
		msg.post("/transknight#movement", "access_hide")
	elseif screen ~= "world" then
		msg.post("/transknight#movement", "preview_hide")
	end
	if self.shop_panel_nodes then set_shop_panel_open(self, screen == "world" and self.shop_panel_open == true) end
	self.active_field = nil
	if self.status_node then
		local access = screen == "login" or screen == "register"
		local create_screen = screen == "create"
		local world_screen = screen == "world"
		local x = screen == "register" and 320 or 270
		local y = screen == "register" and 108 or 130
		local status_x = create_screen and 1000 or (world_screen and 640 or 72)
		local status_y = create_screen and 26 or (world_screen and 142 or 42)
		local pivot = (access or create_screen or world_screen) and gui.PIVOT_CENTER or gui.PIVOT_W
		local scale = access and 0.76 or (create_screen and 0.54 or (world_screen and 0.54 or 1))
		gui.set_position(self.status_node, vmath.vector3(access and x or status_x, access and y or status_y, 0.3))
		gui.set_pivot(self.status_node, pivot)
		gui.set_scale(self.status_node, vmath.vector3(scale, scale, 1))
		if self.status_shadow_node then
			gui.set_position(self.status_shadow_node, vmath.vector3(access and x + 2 or status_x + 2, access and y - 2 or status_y - 2, 0.295))
			gui.set_pivot(self.status_shadow_node, pivot)
			gui.set_scale(self.status_shadow_node, vmath.vector3(scale, scale, 1))
			gui.set_enabled(self.status_shadow_node, access or create_screen or world_screen)
		end
	end
	if self.status_shadow_node then gui.set_font(self.status_shadow_node, "cinzel") end
	if self.status_node then gui.set_font(self.status_node, "cinzel") end
	for _, field in ipairs(self.fields) do render_field(self, field.name) end
end

local function ascii_input(value, mode)
	local out = {}
	for index = 1, #value do
		local byte = string.byte(value, index)
		local allowed = byte >= 32 and byte <= 126
		if mode == "account" then
			allowed = (byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 90) or
				(byte >= 97 and byte <= 122) or byte == 46 or byte == 45 or byte == 95
		elseif mode == "pin" then
			allowed = byte >= 48 and byte <= 57
		elseif mode == "character_name" then
			allowed = (byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 90) or
				(byte >= 97 and byte <= 122) or byte == 95
		elseif mode == "trade_target" then
			allowed = (byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 90) or
				(byte >= 97 and byte <= 122) or byte == 95
		elseif mode == "trade_gold" then
			allowed = byte >= 48 and byte <= 57
		elseif mode == "shop_price" then
			allowed = byte >= 48 and byte <= 57
		end
		if allowed then out[#out + 1] = string.char(byte) end
	end
	return table.concat(out)
end

local function field_limit(name)
	return ({ account = 15, password = 11, password_confirm = 11, pin = 6, character_name = 16,
		trade_target = 16, trade_gold = 10, shop_price = 10 })[name] or 0
end

local function append_text(self, text)
	local name = self.active_field
	if not name then return end
	local value = self.values[name] or ""
	local limit = field_limit(name)
	local filtered = ascii_input(text or "", name)
	local available = limit - #value
	if available > 0 and #filtered > 0 then
		self.values[name] = value .. filtered:sub(1, available)
		render_field(self, name)
		if name == "shop_price" then refresh_player_shop_panel(self) end
	end
end

local function clear_value(self, name)
	self.values[name] = ""
	render_field(self, name)
end

local function send_login(self)
	local account = self.values.account or ""
	local password = self.values.password or ""
	if #account < 1 or #password < 1 then
		set_status(self, "Preencha o ID da conta e a senha.", COLOR_GOLD)
		return
	end
	if not CaracatoaSession.is_valid_account_id(account) then
		set_status(self, "ID inválido: use 1–15 caracteres e comece com letra ou número.", COLOR_GOLD)
		return
	end
	self.login_pending = true
	set_access_idle_throttle(self)
	set_status(self, "Conectando ao servidor Caracatoa local...", COLOR_LOGIN_LABEL)
	msg.post("/local_connection#connection", "ui_login_submit", {
		account_id = account,
		password = password,
	})
	clear_value(self, "password")
	self.active_field = nil
end

local function open_registration(self)
	self.values.password = ""
	self.values.password_confirm = ""
	self.values.pin = ""
	self.login_pending = false
	self.registration_pending = false
	set_screen(self, "register")
	set_active_field(self, "account")
	set_status(self, "Preencha os quatro campos para criar sua conta.", COLOR_LOGIN_LABEL)
end

local function send_registration(self)
	if self.registration_pending then
		set_status(self, "Aguarde a resposta do cadastro atual.", COLOR_GOLD)
		return
	end
	local account = self.values.account or ""
	local password = self.values.password or ""
	local confirmation = self.values.password_confirm or ""
	local pin = self.values.pin or ""
	if not CaracatoaSession.is_valid_account_id(account) then
		set_active_field(self, "account")
		set_status(self, account == "" and "Digite um ID de 1 a 15 caracteres." or "ID inválido. Comece com letra ou número.", COLOR_GOLD)
		return
	end
	if #password < 8 or #password > 11 then
		set_active_field(self, "password")
		set_status(self, password == "" and "Digite uma senha de 8 a 11 caracteres." or "A senha deve ter de 8 a 11 caracteres.", COLOR_GOLD)
		return
	end
	if confirmation == "" or password ~= confirmation then
		set_active_field(self, "password_confirm")
		set_status(self, confirmation == "" and "Repita a senha no campo indicado." or "As senhas não coincidem. Confira novamente.", COLOR_GOLD)
		return
	end
	if #pin < 4 or #pin > 6 or not pin:match("^%d+$") then
		set_active_field(self, "pin")
		set_status(self, pin == "" and "Digite um PIN de 4 a 6 dígitos." or "O PIN deve ter de 4 a 6 dígitos.", COLOR_GOLD)
		return
	end
	self.registration_pending = true
	set_access_idle_throttle(self)
	msg.post("/local_connection#connection", "ui_register_account", {
		account_id = account,
		password = password,
		token = pin,
	})
	self.registration_account = account
	set_active_field(self, nil)
	set_status(self, "Enviando cadastro ao servidor local...", COLOR_LOGIN_LABEL)
end

local function send_pin(self)
	local pin = self.values.pin or ""
	if #pin < 4 or #pin > 6 then
		set_status(self, "A senha numérica deve ter de 4 a 6 dígitos.", COLOR_GOLD)
		return
	end
	msg.post("/local_connection#connection", "ui_pin_submit", { pin = pin })
	clear_value(self, "pin")
	set_status(self, "Validando a senha numérica no servidor local...", COLOR_MUTED)
	self.active_field = nil
end

local function send_create(self)
	local name = self.values.character_name or ""
	if #name < 1 then
		set_status(self, "Digite o nome da personagem.", COLOR_GOLD)
		return
	end
	msg.post("/local_connection#connection", "ui_create_character", {
		slot = self.pending_slot,
		class_id = self.selected_class,
		name = name,
	})
	clear_value(self, "character_name")
	set_status(self, "Criando personagem no servidor local...", COLOR_MUTED)
	self.active_field = nil
end

local show_create_screen

local function submit_primary(self)
	if self.screen == "login" then
		send_login(self)
	elseif self.screen == "register" then
		send_registration(self)
	elseif self.screen == "pin" then
		send_pin(self)
	elseif self.screen == "create" then
		send_create(self)
	elseif self.screen == "roster" then
		for slot = 1, 4 do
			if self.roster[slot] and self.roster[slot].name == "" then
				show_create_screen(self, slot - 1)
				return
			end
		end
		set_status(self, "Os quatro espaços de personagem já estão ocupados.", COLOR_GOLD)
	end
end

show_create_screen = function(self, slot)
	self.pending_slot = slot
	self.selected_class = 0
	self.values.character_name = ""
	set_screen(self, "create")
	set_active_field(self, "character_name")
	select_creator_class(self, self.selected_class)
	set_status(self, "Veja a classe, leia sua história e escolha um nome.")
end

local function send_slot_entry(self, slot)
	local character = self.roster[slot + 1]
	if not character or character.name == "" then
		show_create_screen(self, slot)
		return
	end
	set_status(self, "Entrando no mundo local...", COLOR_MUTED)
	msg.post("/local_connection#connection", "ui_select_character", { slot = slot })
end

local INVENTORY_SLOT_COUNT = 60
local INVENTORY_PAGE_SIZE = 20
local INVENTORY_GRID_COLUMNS = 5
local INVENTORY_CELL_WIDTH = 56
local INVENTORY_CELL_HEIGHT = 52
local INVENTORY_GRID_GAP_X = 12
local INVENTORY_GRID_GAP_Y = 7

local function is_allowed_for_class(definition, class_id)
	for _, allowed_id in ipairs(definition.allowed_class_ids or {}) do
		if allowed_id == class_id then return true end
	end
	return false
end

local function format_itemization_affix(affix)
	local definition = CaracatoaItemization.by_affix_id[affix.client_affix_id]
	local name = definition and definition.name or ("Afixo " .. tostring(affix.client_affix_id))
	if definition and definition.unit == "basis-points" then
		local percent = affix.value / 100
		return string.format("%s +%s%%", name, percent == math.floor(percent) and tostring(math.floor(percent)) or string.format("%.1f", percent))
	end
	return string.format("%s +%d", name, affix.value)
end

local function refresh_inventory_panel(self)
	if not self.world_inventory_rows then return end
	local page = self.world_inventory_page or 0
	local page_count = math.ceil(INVENTORY_SLOT_COUNT / INVENTORY_PAGE_SIZE)
	for index = 1, INVENTORY_PAGE_SIZE do
		local slot = page * INVENTORY_PAGE_SIZE + index - 1
		local item = self.world_inventory and self.world_inventory[slot]
		local button = self.world_inventory_rows[index]
		if item then
			local definition = CaracatoaItems.by_id[item.client_item_id]
			local name = definition and definition.name or CaracatoaItemization.by_item_id[item.client_item_id] or ("Item " .. tostring(item.client_item_id))
			local equipped = false
			if definition and definition.equipment_slot >= 0 then
				local current = self.world_equipment and self.world_equipment[definition.equipment_slot]
				equipped = current ~= nil and current.inventory_slot == slot
			end
			local itemization = self.world_itemization_details and self.world_itemization_details[slot]
			local refinement_level = itemization and itemization.refinement_level or 0
			local refinement = refinement_level > 0 and string.format("+%d", refinement_level) or ""
			local item_label = string.format("%s%s ×%d%s", truncate_utf8(name, 4), refinement, item.stack_count or 1, equipped and " E" or "")
			set_text(self, button.text, item_label)
			local rarity_color = itemization and INVENTORY_RARITY_TEXT_COLORS[itemization.rarity_id] or COLOR_TEXT
			gui.set_color(button.text, equipped and COLOR_GOLD or rarity_color)
			set_surface_color(button.box, self.world_inventory_selected_slot == slot and COLOR_BUTTON_SELECTED or COLOR_BUTTON)
			set_skill_button_enabled(button, true)
		else
			set_text(self, button.text, "—")
			gui.set_color(button.text, COLOR_MUTED)
			set_surface_color(button.box, COLOR_FIELD)
			set_skill_button_enabled(button, false)
		end
	end
	set_text(self, self.world_inventory_page_label, string.format("%02d–%02d / 60", page * INVENTORY_PAGE_SIZE + 1, math.min((page + 1) * INVENTORY_PAGE_SIZE, INVENTORY_SLOT_COUNT)))
	set_skill_button_enabled(self.world_inventory_prev_button, page > 0)
	set_skill_button_enabled(self.world_inventory_next_button, page + 1 < page_count)
	local slot = self.world_inventory_selected_slot
	local item = slot ~= nil and self.world_inventory and self.world_inventory[slot]
	local definition = item and CaracatoaItems.by_id[item.client_item_id]
	local itemization = slot ~= nil and self.world_itemization_details and self.world_itemization_details[slot]
	if itemization then
		local rarity = CaracatoaItemization.rarity_names[itemization.rarity_id] or "Raridade"
		set_text(self, self.world_itemization_rarity, truncate_utf8(string.format("%s · Nv. %d · +%d · ATQ %d · MAG %d", rarity, itemization.item_level, itemization.refinement_level or 0, itemization.base_stats.physical_damage, itemization.base_stats.magic_attack), 38))
		set_text(self, self.world_itemization_stats, string.format("DEF %d · HP +%d · MP +%d", itemization.base_stats.physical_defense, itemization.base_stats.max_hp, itemization.base_stats.max_mp))
		local affix_labels = {}
		for _, affix in ipairs(itemization.affixes or {}) do affix_labels[#affix_labels + 1] = format_itemization_affix(affix) end
		set_text(self, self.world_itemization_affixes, truncate_utf8(#affix_labels > 0 and table.concat(affix_labels, " · ") or "Sem afixos", 38))
	else
		set_text(self, self.world_itemization_rarity, "Selecione um item para ver raridade e nível.")
		set_text(self, self.world_itemization_stats, "")
		set_text(self, self.world_itemization_affixes, "Atributos rolados aparecem aqui.")
	end
	local can_equip = self.world_inventory_ready and self.world_equipment_ready and definition and
		definition.equipment_slot >= 0 and is_allowed_for_class(definition, self.world_class)
	local equipped = can_equip and self.world_equipment[definition.equipment_slot]
	local is_equipped = equipped and equipped.inventory_slot == slot
	if can_equip then
		set_text(self, self.world_equipment_toggle_button.text, is_equipped and "Remover equipamento" or "Equipar selecionado")
	else
		set_text(self, self.world_equipment_toggle_button.text, "Selecione um equipamento")
	end
	set_skill_button_enabled(self.world_equipment_toggle_button, can_equip == true)
	local can_refine = self.world_inventory_ready and itemization ~= nil and definition and definition.equipment_slot >= 0
	local refinement_level = itemization and itemization.refinement_level or 0
	set_text(self, self.world_refinement_button.text, can_refine and "Refinar selecionado" or "Selecione equipamento itemizado")
	set_skill_button_enabled(self.world_refinement_button, can_refine == true and not self.world_refinement_pending)
	set_skill_button_enabled(self.world_divine_refinement_button, can_refine == true and refinement_level >= 9 and not self.world_refinement_pending)
	local totals = self.world_equipment_totals or { attack = 0, defense = 0 }
	set_text(self, self.world_equipment_status, string.format("Equipado · ATQ +%d  DEF +%d", totals.attack or 0, totals.defense or 0))
end

local function refresh_stage_panel(self)
	local stage = self.world_stage_state
	if not stage then
		set_text(self, self.world_stage_label, "Estágio: aguardando servidor")
		set_text(self, self.world_stage_button.text, "Ritual de estágio")
		set_skill_button_enabled(self.world_stage_button, false)
		return
	end
	set_text(self, self.world_stage_label, string.format("%s · Nível %d/400", stage.stage or "Mortal", stage.stage_level or 1))
	local next_stages = { "Arch", "Celestial", "Sub-Celestial" }
	local next_stage = next_stages[(stage.stage_id or 0) + 1]
	if not next_stage then
		set_text(self, self.world_stage_button.text, "Estágio máximo")
		set_skill_button_enabled(self.world_stage_button, false)
		return
	end
	local has_material = false
	for _, item in pairs(self.world_inventory or {}) do
		if item.client_item_id == stage.required_material_client_item_id and (item.stack_count or 0) > 0 then
			has_material = true
			break
		end
	end
	set_text(self, self.world_stage_button.text, "Ritual para " .. next_stage)
	set_skill_button_enabled(self.world_stage_button, stage.stage_level == 400 and has_material and not self.world_stage_pending)
end

local function set_world_detail_panel(self, panel)
	self.world_detail_panel = panel
	for name, nodes in pairs(self.world_panel_nodes or {}) do
		local visible = self.screen == "world" and name == panel
		for _, node in ipairs(nodes) do gui.set_enabled(node, visible) end
	end
	local tabs = {
		{ name = "attributes", button = self.world_attribute_toggle_button, label = "Atributos" },
		{ name = "inventory", button = self.world_inventory_toggle_button, label = "Inventário" },
		{ name = "skills", button = self.world_skills_toggle_button, label = "Habilidades" },
	}
	for _, tab in ipairs(tabs) do
		if tab.button then
			set_text(self, tab.button.text, panel == tab.name and "Fechar" or tab.label)
		end
	end
	if panel == "inventory" then refresh_inventory_panel(self) end
	if panel == "skills" then refresh_skill_panel(self) end
end

local function toggle_world_detail_panel(self, panel)
	local target = self.world_detail_panel == panel and nil or panel
	if target then
		set_mount_panel_open(self, false)
		set_trade_panel_open(self, false)
		set_shop_panel_open(self, false)
	end
	set_world_detail_panel(self, target)
end

local function select_inventory_slot(self, slot)
	local item = self.world_inventory and self.world_inventory[slot]
	if not item then
		set_status(self, "Esse espaço do inventário está vazio.", COLOR_GOLD)
		return
	end
	self.world_inventory_selected_slot = slot
	self.world_inventory_page = math.floor(slot / INVENTORY_PAGE_SIZE)
	refresh_inventory_panel(self)
	refresh_trade_panel(self)
	refresh_player_shop_panel(self)
end

local function request_mount_action(self, action)
	local mount = self.world_mounts and self.world_mounts[self.world_mount_selected_index or 1]
	local item_action = action == "incubate" or action == "feed" or action == "evolve"
	if action ~= "list" and not mount then
		set_status(self, "O servidor ainda não informou uma montaria.", COLOR_GOLD)
		return
	end
	local inventory_slot = item_action and self.world_inventory_selected_slot or nil
	if item_action and (inventory_slot == nil or not (self.world_inventory or {})[inventory_slot]) then
		set_status(self, "Selecione no inventário o material ou a ração.", COLOR_GOLD)
		return
	end
	self.world_mount_pending = true
	refresh_mount_panel(self)
	msg.post("/local_connection#connection", "world_mount_action", {
		action = action,
		mount_id = mount and mount.id or nil,
		inventory_slot = inventory_slot,
	})
end

local function handle_button(self, action)
	if action == "login" then
		send_login(self)
	elseif action == "register_open" then
		open_registration(self)
	elseif action == "register_confirm" then
		send_registration(self)
	elseif action == "register_back" then
		self.values.password = ""
		self.values.password_confirm = ""
		self.values.pin = ""
		set_screen(self, "login")
		set_active_field(self, "account")
		set_status(self, "Entre com a sua conta Caracatoa local.")
	elseif action == "pin_submit" then
		send_pin(self)
	elseif action == "create_open" then
		for slot = 1, 4 do
			if self.roster[slot] and self.roster[slot].name == "" then
				show_create_screen(self, slot - 1)
				return
			end
		end
		set_status(self, "Os quatro espaços de personagem já estão ocupados.", COLOR_GOLD)
	elseif action == "create_confirm" then
		send_create(self)
	elseif action == "back_login" then
		msg.post("/local_connection#connection", "ui_cancel_session")
		clear_value(self, "password")
		clear_value(self, "pin")
		set_screen(self, "login")
		set_status(self, "Servidor local Caracatoa em 127.0.0.1:8289.")
	elseif action == "back_roster" then
		msg.post("/camera#preview_camera", "selection_overview")
		for _, url in ipairs({ "/transknight#avatar_animation", "/foema#avatar_animation", "/beastmaster#avatar_animation", "/huntress#avatar_animation" }) do
			msg.post(url, "creator_overview")
		end
		set_screen(self, "roster")
		set_status(self, "Selecione um espaço ou crie uma personagem.")
	elseif action == "logout" then
		msg.post("/local_connection#connection", "ui_cancel_session")
		self.values.password = ""
		self.values.pin = ""
		self.values.character_name = ""
		set_screen(self, "login")
		set_status(self, "Desconectado do servidor Caracatoa local.")
	elseif action == "attributes_toggle" then
		toggle_world_detail_panel(self, "attributes")
	elseif action == "inventory_toggle" then
		toggle_world_detail_panel(self, "inventory")
	elseif action == "skills_toggle" then
		toggle_world_detail_panel(self, "skills")
	elseif action == "mount_toggle" then
		if not self.mount_panel_open then
			set_world_detail_panel(self, nil)
			set_trade_panel_open(self, false)
			set_shop_panel_open(self, false)
		end
		set_mount_panel_open(self, not self.mount_panel_open)
		if self.mount_panel_open then
			if not self.world_mount_snapshot_ready then request_mount_action(self, "list") else refresh_mount_panel(self) end
		end
	elseif action == "mount_close" then
		set_mount_panel_open(self, false)
	elseif action == "trade_toggle" then
		if not self.trade_panel_open then
			set_world_detail_panel(self, nil)
			set_mount_panel_open(self, false)
			set_shop_panel_open(self, false)
		end
		set_trade_panel_open(self, not self.trade_panel_open)
		if self.trade_panel_open then set_active_field(self, "trade_target") end
	elseif action == "trade_close" then
		set_trade_panel_open(self, false)
	elseif action == "trade_invite" then
		request_trade_action(self, "invite")
	elseif action == "trade_accept" then
		request_trade_action(self, "accept")
	elseif action == "trade_decline" then
		request_trade_action(self, "decline")
	elseif action == "trade_offer_item" then
		request_trade_action(self, "offer", true)
	elseif action == "trade_offer_gold" then
		request_trade_action(self, "offer", false)
	elseif action == "trade_ready" then
		request_trade_action(self, "ready")
	elseif action == "trade_cancel" then
		request_trade_action(self, "cancel")
	elseif action == "shop_toggle" then
		if not self.shop_panel_open then
			set_world_detail_panel(self, nil)
			set_mount_panel_open(self, false)
			set_trade_panel_open(self, false)
		end
		set_shop_panel_open(self, not self.shop_panel_open)
		if self.shop_panel_open then
			set_active_field(self, "shop_price")
			request_player_shop_action(self, "list")
		end
	elseif action == "shop_close" then
		set_shop_panel_open(self, false)
	elseif action == "shop_market" then
		request_player_shop_action(self, "list")
	elseif action == "shop_mine" then
		request_player_shop_action(self, "mine")
	elseif action == "shop_create" then
		request_player_shop_action(self, "create")
	elseif action == "shop_buy" then
		request_player_shop_action(self, "buy")
	elseif action == "shop_cancel" then
		request_player_shop_action(self, "cancel")
	elseif action == "shop_refresh" then
		local view = self.world_shop_state and self.world_shop_state.view == "mine" and "mine" or "list"
		request_player_shop_action(self, view)
	elseif action == "mount_previous" or action == "mount_next" then
		local count = #(self.world_mounts or {})
		if count > 1 then
			local delta = action == "mount_next" and 1 or -1
			self.world_mount_selected_index = ((self.world_mount_selected_index - 1 + delta) % count) + 1
			refresh_mount_panel(self)
		end
	elseif action == "mount_refresh" then
		request_mount_action(self, "list")
	elseif action == "mount_incubate" then
		request_mount_action(self, "incubate")
	elseif action == "mount_feed" then
		request_mount_action(self, "feed")
	elseif action == "mount_evolve" then
		request_mount_action(self, "evolve")
	elseif action == "mount_select" then
		request_mount_action(self, "select")
	elseif action == "mount_ride" then
		local mount = self.world_mounts and self.world_mounts[self.world_mount_selected_index or 1]
		request_mount_action(self, mount and mount.riding and "dismount" or "ride")
	elseif action == "skill_cast_primary" or action == "skill_cast_secondary" or action == "skill_cast_tertiary" then
		local slot = action == "skill_cast_primary" and 1 or action == "skill_cast_secondary" and 2 or 3
		cast_skill_slot(self, slot)
	elseif action == "skill_learn_primary" or action == "skill_learn_secondary" or action == "skill_learn_tertiary" then
		local slot = action == "skill_learn_primary" and 1 or action == "skill_learn_secondary" and 2 or 3
		local skill_id = self.world_skill_slot_ids and self.world_skill_slot_ids[slot]
		if skill_id then msg.post("/local_connection#connection", "world_skill_learn", { skill_id = skill_id }) end
	elseif action == "attribute_str" then
		msg.post("/local_connection#connection", "world_attribute_allocate", { attribute_id = 0 })
	elseif action == "attribute_int" then
		msg.post("/local_connection#connection", "world_attribute_allocate", { attribute_id = 1 })
	elseif action == "attribute_dex" then
		msg.post("/local_connection#connection", "world_attribute_allocate", { attribute_id = 2 })
	elseif action == "attribute_con" then
		msg.post("/local_connection#connection", "world_attribute_allocate", { attribute_id = 3 })
	elseif action == "inventory_prev" then
		self.world_inventory_page = math.max(0, (self.world_inventory_page or 0) - 1)
		refresh_inventory_panel(self)
	elseif action == "inventory_next" then
		self.world_inventory_page = math.min(math.ceil(INVENTORY_SLOT_COUNT / INVENTORY_PAGE_SIZE) - 1, (self.world_inventory_page or 0) + 1)
		refresh_inventory_panel(self)
	elseif action:sub(1, 15) == "inventory_slot_" then
		select_inventory_slot(self, tonumber(action:sub(16)))
	elseif action == "equipment_toggle" then
		local slot = self.world_inventory_selected_slot
		local item = slot ~= nil and self.world_inventory and self.world_inventory[slot]
		local definition = item and CaracatoaItems.by_id[item.client_item_id]
		if definition and definition.equipment_slot >= 0 then
			msg.post("/local_connection#connection", "world_equipment_toggle", {
				equipment_slot = definition.equipment_slot,
				inventory_slot = slot,
			})
		else
			set_status(self, "Selecione uma peça equipável do inventário.", COLOR_GOLD)
		end
	elseif action == "refine_selected" or action == "refine_selected_divine" then
		local slot = self.world_inventory_selected_slot
		local item = slot ~= nil and self.world_inventory and self.world_inventory[slot]
		local itemization = slot ~= nil and self.world_itemization_details and self.world_itemization_details[slot]
		local definition = item and CaracatoaItems.by_id[item.client_item_id]
		if definition and definition.equipment_slot >= 0 and itemization then
			self.world_refinement_pending = true
			refresh_inventory_panel(self)
			msg.post("/local_connection#connection", "world_refine_item", {
				inventory_slot = slot,
				use_divine_dust = action == "refine_selected_divine",
			})
		else
			set_status(self, "Selecione um equipamento itemizado para refinar.", COLOR_GOLD)
		end
	elseif action == "stage_ritual" then
		if not self.world_stage_pending then
			self.world_stage_pending = true
			refresh_stage_panel(self)
			msg.post("/local_connection#connection", "world_stage_ritual")
		end
	end
end

local function handle_mouse_click(self, action)
	for _, field in ipairs(self.fields) do
		if field.screen == self.screen and field_is_available(self, field) and hit_rect_contains(field.hit_rect, action.x, action.y) then
			set_active_field(self, field.name)
			return true
		end
	end
	for _, button in ipairs(self.buttons) do
		if button.screen == self.screen and button_is_available(self, button) and hit_rect_contains(button.hit_rect, action.x, action.y) then
			if button.action:sub(1, 5) == "slot_" then
				send_slot_entry(self, tonumber(button.action:sub(6)) - 1)
			elseif button.action:sub(1, 6) == "class_" then
				select_creator_class(self, tonumber(button.action:sub(7)))
				set_status(self, "Classe selecionada: " .. CLASS_NAMES[self.selected_class + 1] .. ".")
			elseif button.action:sub(1, 13) == "shop_listing_" then
				self.world_shop_selected_index = tonumber(button.action:sub(14)) or 1
				refresh_player_shop_panel(self)
			else
				handle_button(self, button.action)
			end
			return true
		end
	end
	return true
end

function init(self)
	msg.post(".", "acquire_input_focus")
	self.html5_preview = sys.get_sys_info().system_name == "HTML5"
	self.screen_nodes = { login = {}, register = {}, pin = {}, roster = {}, create = {}, world = {} }
	self.fields = {}
	self.buttons = {}
	self.class_buttons = {}
	self.world_skill_learned = {}
	self.world_skill_points_value = 0
	self.world_defense_remaining = 0
	self.world_defense_bonus = 0
	self.world_experience = 0
	self.world_equipment_ready = false
	self.world_equipment = {}
	self.world_equipment_totals = { attack = 0, defense = 0 }
	self.world_inventory = {}
	self.world_itemization_details = {}
	self.world_inventory_page = 0
	self.world_inventory_selected_slot = nil
	self.world_inventory_ready = false
	self.world_mounts = {}
	self.world_mount_selected_index = 1
	self.world_mount_snapshot_ready = false
	self.world_mount_pending = false
	self.world_mount_status_result = nil
	self.world_stage_state = nil
	self.world_stage_pending = false
	self.world_refinement_pending = false
	self.mount_panel_open = false
	self.trade_panel_open = false
	self.shop_panel_open = false
	self.world_trade_state = nil
	self.world_trade_pending = false
	self.world_trade_local_message = nil
	self.world_shop_state = nil
	self.world_shop_pending = false
	self.world_shop_local_message = nil
	self.world_shop_selected_index = 1
	self.world_shop_receipt = nil
	self.values = { account = "", password = "", password_confirm = "", pin = "", character_name = "", trade_target = "", trade_gold = "", shop_price = "" }
	self.roster = {
		{ name = "", class_id = 0, level = 0 },
		{ name = "", class_id = 0, level = 0 },
		{ name = "", class_id = 0, level = 0 },
		{ name = "", class_id = 0, level = 0 },
	}

