local function report_hud_registration_test(self, passed, phase)
	local state = self.hud_registration_test
	if not HUD_REGISTRATION_TEST_MODE or not state or state.reported then return end
	state.reported = true
	local prefix = HUD_ONBOARDING_TEST_MODE and "HUD_ONBOARDING_TEST_" or "HUD_REGISTRATION_TEST_"
	msg.post("/local_connection#connection", "ui_hud_registration_test_result", {
		passed = passed == true,
		phase = phase or state.phase or "unknown",
		prefix = prefix,
	})
end

local function begin_hud_registration_test(self, message)
	if not HUD_REGISTRATION_TEST_MODE then return end
	local state = {
		phase = "setup",
		account_id = message.account_id,
		password = message.password,
		pin = message.pin,
		character_name = message.character_name,
		class_id = message.class_id,
	}
	self.hud_registration_test = state
	if type(state.account_id) ~= "string" or type(state.password) ~= "string" or type(state.pin) ~= "string" then
		report_hud_registration_test(self, false, "input")
		return
	end
	if HUD_ONBOARDING_TEST_MODE and
		(type(state.character_name) ~= "string" or not state.character_name:match("^[A-Za-z0-9_]+$") or
		type(state.class_id) ~= "number" or state.class_id < 0 or state.class_id > 3 or state.class_id ~= math.floor(state.class_id)) then
		report_hud_registration_test(self, false, "onboarding-input")
		return
	end
	handle_mouse_click(self, { x = 270, y = 215 })
	if self.screen ~= "register" then
		report_hud_registration_test(self, false, "open-registration")
		return
	end
	self.values.account = state.account_id
	self.values.password = state.password
	self.values.password_confirm = state.password
	self.values.pin = state.pin
	for _, name in ipairs({ "account", "password", "password_confirm", "pin" }) do
		render_field(self, name)
	end
	state.phase = "register"
	handle_mouse_click(self, { x = 320, y = 210 })
	if not self.registration_pending then
		report_hud_registration_test(self, false, "registration-validation")
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("camera_mode_changed") then
		if type(message.name) == "string" and type(message.distance) == "number" then
			set_status(self, string.format("Câmera %s · %.1f m", message.name, message.distance), COLOR_GOLD)
		end
	elseif message_id == hash("hud_registration_test_start") then
		begin_hud_registration_test(self, message)
	elseif message_id == hash("hud_input_test_start") then
		handle_mouse_click(self, { x = 270, y = 215 })
		local registration_opened = self.screen == "register"
		handle_mouse_click(self, { x = 320, y = 210 })
		local passed = registration_opened and self.screen == "register" and
			self.status == "Digite um ID de 1 a 15 caracteres." and not self.registration_pending
		msg.post("/local_connection#connection", "ui_hud_input_test_result", { passed = passed })
	elseif message_id == hash("server_status") and message.text then
		set_status(self, message.text)
	elseif message_id == hash("account_registration_result") then
		if message.success then
			self.registration_pending = false
			self.values.account = message.account_id or self.registration_account or ""
			self.values.password = ""
			self.values.password_confirm = ""
			self.values.pin = ""
			set_screen(self, "login")
			set_active_field(self, "password")
			set_status(self, "Conta criada. Entre com sua senha para continuar.", COLOR_GOLD)
			local test = self.hud_registration_test
			if HUD_REGISTRATION_TEST_MODE and test and test.phase == "register" then
				test.phase = "login"
				self.values.account = message.account_id or test.account_id
				self.values.password = test.password
				render_field(self, "account")
				render_field(self, "password")
				handle_mouse_click(self, { x = 270, y = 277 })
				if not self.login_pending then report_hud_registration_test(self, false, "login-submit") end
			end
		else
			self.registration_pending = false
			set_screen(self, "register")
			set_active_field(self, self.values.account and self.values.account ~= "" and "password" or "account")
			set_status(self, message.text or "Não foi possível criar a conta local.", COLOR_GOLD)
			if HUD_REGISTRATION_TEST_MODE then report_hud_registration_test(self, false, "registration-response") end
		end
	elseif message_id == hash("session_pin_required") then
		self.login_pending = false
		self.values.pin = ""
		set_screen(self, "pin")
		set_active_field(self, "pin")
		set_status(self, "ID e senha aceitos. Informe o PIN da conta.")
		local test = self.hud_registration_test
		if HUD_REGISTRATION_TEST_MODE and test and test.phase == "login" then
			test.phase = "pin"
			self.values.pin = test.pin
			render_field(self, "pin")
			handle_mouse_click(self, { x = 270, y = 330 })
			if self.status ~= "Validando a senha numérica no servidor local..." then
				report_hud_registration_test(self, false, "pin-submit")
			end
		end
	elseif message_id == hash("session_roster") then
		self.login_pending = false
		print("[Caracatoa HUD] roster recebido")
		msg.post("/camera#preview_camera", "selection_overview")
		for slot = 1, 4 do
			local name = message["slot" .. slot .. "_name"] or ""
			local class_id = message["slot" .. slot .. "_class"] or 0
			local level = message["slot" .. slot .. "_level"] or 0
			self.roster[slot] = { name = name, class_id = class_id, level = level }
			local label = "Espaço " .. slot .. " - vazio"
			if name ~= "" then
				local class_name = CLASS_NAMES[class_id + 1] or "Classe " .. tostring(class_id)
				label = string.format("%s  |  Nv. %d  |  %s", name, level, class_name)
			end
			set_text(self, self.roster_buttons[slot].text, label)
		end
		self.values.password = ""
		self.values.pin = ""
		set_screen(self, "roster")
		set_status(self, "Escolha uma personagem ou crie uma nova.")
		local test = self.hud_registration_test
		if HUD_REGISTRATION_TEST_MODE and test and test.phase == "pin" then
			local empty_roster = true
			for slot = 1, 4 do
				if self.roster[slot].name ~= "" then empty_roster = false; break end
			end
			if not empty_roster then
				report_hud_registration_test(self, false, "empty-roster")
			elseif HUD_ONBOARDING_TEST_MODE then
				test.phase = "create"
				handle_mouse_click(self, { x = 270, y = 185 })
				if self.screen ~= "create" then
					report_hud_registration_test(self, false, "open-character-creation")
				else
					self.values.character_name = test.character_name
					render_field(self, "character_name")
					handle_mouse_click(self, { x = 792 + test.class_id * 138, y = 550 })
					if self.selected_class ~= test.class_id then
						report_hud_registration_test(self, false, "select-class")
					else
						handle_mouse_click(self, { x = 1000, y = 105 })
						if self.status ~= "Criando personagem no servidor local..." then
							report_hud_registration_test(self, false, "create-character-submit")
						end
					end
				end
			else
				report_hud_registration_test(self, true, "roster")
			end
		elseif HUD_ONBOARDING_TEST_MODE and test and test.phase == "await-created-roster" then
			local character = self.roster[1]
			if not character or character.name ~= test.character_name or character.class_id ~= test.class_id then
				report_hud_registration_test(self, false, "created-roster")
			else
				test.phase = "entry"
				handle_mouse_click(self, { x = 270, y = 485 })
				if self.status ~= "Entrando no mundo local..." then
					report_hud_registration_test(self, false, "character-entry-submit")
				end
			end
		end
	elseif message_id == hash("character_created") then
		set_status(self, "Personagem criada. Atualizando espaços...")
		local test = self.hud_registration_test
		if HUD_ONBOARDING_TEST_MODE and test and test.phase == "create" then
			test.phase = "await-created-roster"
		end
	elseif message_id == hash("world_ready") then
		msg.post("/transknight#movement", "world_bootstrap", {
			class_id = message.class_id,
			mob_index = message.mob_index,
			x = message.x,
			y = message.y,
		})
		set_text(self, self.world_name, string.format("Nv. %d  ·  %s  ·  %s", message.level or 1, message.name or "Personagem", CLASS_NAMES[(message.class_id or 0) + 1] or "Classe Caracatoa"))
		set_text(self, self.world_details, string.format("Mundo local  ·  (%d, %d)  ·  WASD", message.x or 0, message.y or 0))
		self.world_character_name = message.name or "Personagem"
		self.world_class = message.class_id or 0
		self.world_level = message.level or 1
		self.world_max_hp = nil
		self.world_max_mp = nil
		self.world_target_max_hp = nil
		set_world_vitals(self, nil, nil, nil, nil)
		set_text(self, self.world_target, "Alvo: nenhum")
		set_world_target_health(self, nil, nil)
		set_text(self, self.world_skill_status, self.world_class == 1 and "Habilidades arcanas da Foema" or "Habilidades ativas da classe")
		self.world_skill_learned = {}
		self.world_skill_points_value = 0
		self.world_equipment_ready = false
		self.world_equipment = {}
		self.world_equipment_totals = { attack = 0, defense = 0 }
		self.world_inventory = {}
		self.world_itemization_details = {}
		self.world_inventory_page = 0
		self.world_inventory_selected_slot = nil
		self.world_inventory_ready = false
		self.world_mounts = {}
		self.world_mount_selected_index = 1
		self.world_mount_snapshot_ready = false
		self.world_mount_pending = false
		self.world_mount_status_result = nil
		self.world_trade_state = nil
		self.world_trade_pending = false
		self.world_trade_local_message = nil
		self.world_shop_state = nil
		self.world_shop_pending = false
		self.world_shop_local_message = nil
		self.world_shop_selected_index = 1
		self.world_shop_receipt = nil
		self.world_detail_panel = nil
		set_trade_panel_open(self, false)
		set_mount_panel_open(self, false)
		set_shop_panel_open(self, false)
		set_text(self, self.world_equipment_status, "Equipado · ATQ +0  DEF +0")
		set_skill_button_enabled(self.world_equipment_toggle_button, false)
		set_text(self, self.world_attribute_stats, "STR —  |  INT —  |  DEX —  |  CON —")
		set_text(self, self.world_attribute_points, "Pontos disponíveis: aguardando servidor")
		set_text(self, self.world_attribute_status, "Distribua pontos confirmados pelo servidor.")
		set_screen(self, "world")
		set_world_detail_panel(self, nil)
		set_world_experience(self, message.experience or 0, self.world_level)
		refresh_skill_panel(self)
		refresh_inventory_panel(self)
		refresh_mount_panel(self)
		refresh_trade_panel(self)
		refresh_player_shop_panel(self)
		set_status(self, "WASD mover · V câmera · scroll zoom")
		local test = self.hud_registration_test
		if HUD_ONBOARDING_TEST_MODE and test and test.phase == "entry" then
			local passed = message.name == test.character_name and message.class_id == test.class_id
			test.phase = passed and "world" or "world-mismatch"
			report_hud_registration_test(self, passed, "world")
		end
	elseif message_id == hash("world_inventory_reset") then
		self.world_inventory = {}
		self.world_itemization_details = {}
		self.world_inventory_selected_slot = nil
		self.world_inventory_ready = false
		refresh_inventory_panel(self)
		refresh_trade_panel(self)
		refresh_player_shop_panel(self)
	elseif message_id == hash("world_inventory_updated") then
		local slot = message.slot
		if type(slot) == "number" and slot >= 0 and slot < INVENTORY_SLOT_COUNT and slot == math.floor(slot) then
			if (message.client_item_id or 0) == 0 then
				self.world_inventory[slot] = nil
				self.world_itemization_details[slot] = nil
				if self.world_inventory_selected_slot == slot then self.world_inventory_selected_slot = nil end
			else
				self.world_itemization_details[slot] = nil
				self.world_inventory[slot] = {
					client_item_id = message.client_item_id,
					stack_count = message.stack_count or 1,
				}
				if self.world_inventory_selected_slot == nil then
					self.world_inventory_selected_slot = slot
					self.world_inventory_page = math.floor(slot / INVENTORY_PAGE_SIZE)
				end
			end
			refresh_inventory_panel(self)
			refresh_mount_panel(self)
			refresh_stage_panel(self)
			refresh_trade_panel(self)
			refresh_player_shop_panel(self)
		end
	elseif message_id == hash("world_itemization_updated") then
		local slot = message.slot
		if type(slot) == "number" and slot >= 0 and slot < INVENTORY_SLOT_COUNT and slot == math.floor(slot) then
			self.world_itemization_details = self.world_itemization_details or {}
			if message.status == 2 then
				self.world_itemization_details[slot] = nil
			else
				local affixes = {}
				for index = 1, math.min(4, message.affix_count or 0) do
					affixes[#affixes + 1] = {
						client_affix_id = message["affix_" .. index .. "_id"],
						value = message["affix_" .. index .. "_value"],
					}
				end
				self.world_itemization_details[slot] = {
					rarity_id = message.rarity_id,
					item_level = message.item_level,
					base_stats = {
						physical_damage = message.physical_damage,
						magic_attack = message.magic_attack,
						physical_defense = message.physical_defense,
						max_hp = message.max_hp,
						max_mp = message.max_mp,
					},
					refinement_level = message.refinement_level or 0,
					affixes = affixes,
				}
			end
			refresh_inventory_panel(self)
		end
	elseif message_id == hash("world_inventory_snapshot_complete") then
		self.world_inventory_ready = true
		if self.world_inventory_selected_slot == nil then
			for slot = 0, INVENTORY_SLOT_COUNT - 1 do
				if self.world_inventory[slot] then
					self.world_inventory_selected_slot = slot
					self.world_inventory_page = math.floor(slot / INVENTORY_PAGE_SIZE)
					break
				end
			end
		end
		refresh_inventory_panel(self)
		refresh_mount_panel(self)
		refresh_stage_panel(self)
		refresh_player_shop_panel(self)
	elseif message_id == hash("world_position") then
		set_text(self, self.world_details, string.format("Mundo local  ·  (%d, %d)  ·  WASD", message.x or 0, message.y or 0))
	elseif message_id == hash("world_progression_updated") then
		local previous_level = self.world_level or message.level or 1
		local previous_experience = self.world_experience or message.experience or 0
		self.world_level = message.level or previous_level
		set_world_experience(self, message.experience, self.world_level)
		local experience_gained = type(message.experience) == "number" and math.max(0, message.experience - previous_experience) or 0
		if experience_gained > 0 then
			show_world_combat_feedback(self, "+" .. CaracatoaProgression.format_count(experience_gained) .. " EXP", COLOR_COMBAT_EXPERIENCE)
		end
		refresh_skill_panel(self)
		set_text(self, self.world_name, string.format("Nv. %d  ·  %s  ·  %s", self.world_level, self.world_character_name or "Personagem", CLASS_NAMES[(self.world_class or 0) + 1] or "Classe Caracatoa"))
		set_text(self, self.world_details, string.format("Mundo local  ·  (%d, %d)  ·  WASD", message.x or 0, message.y or 0))
		if self.world_level > previous_level then
			set_status(self, string.format("Você alcançou o nível %d.", self.world_level), COLOR_GOLD)
		elseif message.experience and message.experience > previous_experience then
			set_status(self, string.format("+%s EXP", CaracatoaProgression.format_count(message.experience - previous_experience)), COLOR_GOLD)
		end
	elseif message_id == hash("world_target_updated") then
		if message.entity_id then
			self.world_target_max_hp = message.max_hp
			set_text(self, self.world_target, string.format("%s  ·  #%04X", truncate_utf8(message.name or "Criatura", 24), message.entity_id))
			set_world_target_health(self, message.current_hp, message.max_hp)
		else
			self.world_target_max_hp = nil
			set_text(self, self.world_target, "Alvo: nenhum")
			set_world_target_health(self, nil, nil)
		end
	elseif message_id == hash("world_resources_updated") then
		set_world_vitals(self, message.current_hp, message.max_hp, message.current_mp, message.max_mp)
	elseif message_id == hash("world_skill_pending") then
		set_text(self, self.world_skill_status, "Conjurando " .. (message.skill_name or "habilidade") .. "...")
		set_status(self, "Aguardando validação do servidor local.")
	elseif message_id == hash("world_skill_result") then
		set_world_vitals(self, message.current_hp, message.max_hp, message.current_mp, message.max_mp)
		if message.target_hp then set_world_target_health(self, message.target_hp, self.world_target_max_hp) end
		if message.effect_type == "heal" then
			set_text(self, self.world_skill_status, string.format("%s: +%d HP", message.skill_name or "Cura", message.healed or 0))
			if type(message.healed) == "number" and message.healed > 0 then
				show_world_combat_feedback(self, "+" .. CaracatoaProgression.format_count(message.healed), COLOR_COMBAT_HEAL)
			end
		elseif message.effect_type == "defense" then
			self.world_defense_remaining = (message.duration_ms or 0) / 1000
			self.world_defense_bonus = message.defense_bonus or 0
			self.world_defense_skill_name = message.skill_name or "Postura defensiva"
			set_text(self, self.world_skill_status, string.format("%s: +%d DEF por %d s", self.world_defense_skill_name, self.world_defense_bonus, math.floor(self.world_defense_remaining)))
		else
			set_text(self, self.world_skill_status, string.format("%s: %d dano", message.skill_name or "Habilidade", message.damage or 0))
			if type(message.damage) == "number" and message.damage > 0 then
				show_world_combat_feedback(self, "-" .. CaracatoaProgression.format_count(message.damage), COLOR_COMBAT_DAMAGE)
			end
		end
		set_status(self, (message.skill_name or "Habilidade") .. " confirmada pelo servidor.")
	elseif message_id == hash("world_skill_rejected") then
		set_text(self, self.world_skill_status, message.text or "Habilidade indisponível")
		set_status(self, message.text or "O servidor recusou a habilidade.", COLOR_GOLD)
	elseif message_id == hash("world_skill_state_updated") then
		self.world_skill_learned = self.world_skill_learned or {}
		for skill_id, _ in pairs(CaracatoaSkills.by_id) do
			self.world_skill_learned[skill_id] = message["learned_" .. skill_id] == true
		end
		self.world_skill_points_value = message.skill_points or 0
		refresh_skill_panel(self)
		local changed_skill = CaracatoaSkills.by_id[message.skill_id]
		local skill_name = changed_skill and changed_skill.name or "Habilidade"
		if message.status == 1 then
			set_status(self, skill_name .. " foi aprendida e salva.", COLOR_GOLD)
		elseif message.status == 3 then
			set_text(self, self.world_skill_tree_status, "Precisa de 1 ponto de habilidade")
		elseif message.status == 4 then
			set_text(self, self.world_skill_tree_status, "Requer nível 2")
		elseif message.status == 5 then
			local prerequisite_id = changed_skill and changed_skill.prerequisites[1]
			local prerequisite = prerequisite_id and CaracatoaSkills.by_id[prerequisite_id]
			set_text(self, self.world_skill_tree_status, prerequisite and ("Aprenda " .. prerequisite.name .. " primeiro") or "Pré-requisito não atendido")
		elseif message.status == 6 then
			local required_class = changed_skill and CLASS_NAMES[(changed_skill.class_id or 0) + 1] or "classe da habilidade"
			set_text(self, self.world_skill_tree_status, "Requer classe " .. required_class)
		elseif message.status == 7 then
			set_text(self, self.world_skill_tree_status, "Habilidade indisponível neste catálogo")
		else
			set_text(self, self.world_skill_tree_status, "Servidor valida nível, pontos e pré-requisitos.")
		end
	elseif message_id == hash("world_skill_learning_pending") then
		set_text(self, self.world_skill_tree_status, "Validando e salvando " .. (message.skill_name or "habilidade") .. "...")
		set_status(self, "Aguardando confirmação do servidor local.")
	elseif message_id == hash("world_skill_learning_rejected") then
		set_text(self, self.world_skill_tree_status, message.text or "Aprendizado recusado")
		set_status(self, message.text or "O servidor recusou o aprendizado.", COLOR_GOLD)
	elseif message_id == hash("world_attributes_updated") then
		set_world_vitals(self, message.current_hp, message.max_hp, message.current_mp, message.max_mp)
		set_text(self, self.world_attribute_stats, string.format(
			"STR %d  |  INT %d  |  DEX %d  |  CON %d",
			message.str or 0, message.int or 0, message.dex or 0, message.con or 0))
		set_text(self, self.world_attribute_points, string.format("Pontos disponíveis: %d", message.available_points or 0))
		if message.status == 0 then
			set_text(self, self.world_attribute_status, string.format("Aplicado. Dano %d  |  Defesa %d  |  HP máx. %d  |  MP máx. %d", message.damage or 0, message.defense or 0, message.max_hp or 0, message.max_mp or 0))
			set_status(self, "Servidor confirmou e salvou o ponto de atributo.")
		elseif message.status == 1 then
			set_text(self, self.world_attribute_status, "Sem pontos livres. Ganhe um nível para receber mais.")
		elseif message.status == 2 then
			set_text(self, self.world_attribute_status, "Este atributo atingiu o limite do perfil atual.")
		else
			set_text(self, self.world_attribute_status, string.format("Dano %d  |  Defesa %d  |  HP máx. %d  |  MP máx. %d", message.damage or 0, message.defense or 0, message.max_hp or 0, message.max_mp or 0))
		end
	elseif message_id == hash("world_attribute_pending") then
		set_text(self, self.world_attribute_status, "Aguardando validação e gravação do servidor...")
	elseif message_id == hash("world_attribute_rejected") then
		set_text(self, self.world_attribute_status, message.text or "A distribuição não foi aceita.")
		set_status(self, message.text or "O servidor recusou a distribuição.", COLOR_GOLD)
	elseif message_id == hash("world_stage_updated") then
		self.world_stage_state = {
			stage = message.stage,
			stage_id = message.stage_id,
			stage_level = message.stage_level,
			total_level = message.total_level,
			experience = message.experience,
			available_attribute_points = message.available_attribute_points,
			available_skill_points = message.available_skill_points,
			required_material_client_item_id = message.required_material_client_item_id,
			status = message.status,
			reason = message.reason,
		}
		self.world_stage_pending = false
		refresh_stage_panel(self)
		if message.status == 1 then
			set_status(self, string.format("Ritual concluído: %s · nível %d.", message.stage or "novo estágio", message.stage_level or 1), COLOR_GOLD)
		elseif message.status == 2 then
			local reason = ({ [1] = "O estágio requer nível 400.", [2] = "Falta o material do ritual.", [3] = "Este personagem já está no estágio máximo.", [4] = "O servidor não conseguiu salvar o estágio.", [5] = "Limite de pontos atingido.", [6] = "O pedido do ritual já foi usado." })[message.reason] or "O servidor recusou o ritual."
			set_status(self, reason, COLOR_GOLD)
		end
	elseif message_id == hash("world_stage_pending") then
		self.world_stage_pending = true
		refresh_stage_panel(self)
		set_status(self, "O altar está validando o ritual no servidor local.", COLOR_GOLD)
	elseif message_id == hash("world_stage_rejected") then
		self.world_stage_pending = false
		refresh_stage_panel(self)
		set_status(self, message.text or "O ritual não pôde ser enviado.", COLOR_GOLD)
	elseif message_id == hash("world_refinement_updated") then
		self.world_refinement_pending = false
		refresh_inventory_panel(self)
		local status = message.status
		if status == 0 then
			set_status(self, string.format("Refino concluído: +%d · chance %.2f%%.", message.new_level or 0, (message.chance_bps or 0) / 100), COLOR_GOLD)
		elseif status == 1 then
			set_status(self, string.format("Refino falhou. O item ficou em +%d.", message.new_level or 0), COLOR_GOLD)
		elseif status == 3 then
			set_status(self, "Este pedido de refino já havia sido processado.", COLOR_GOLD)
		else
			local reason = ({ [1] = "Slot vazio.", [2] = "O item não aceita refino.", [3] = "O nível do item supera o do personagem.", [4] = "O item já está em +15.", [5] = "Falta o catalisador.", [6] = "Falta a Poeira Divina.", [7] = "A Poeira Divina só pode ser usada a partir do alvo +10.", [8] = "A pilha do equipamento é inválida.", [9] = "O servidor não conseguiu salvar o refino.", [10] = "O identificador do pedido já foi usado." })[message.reason] or "O servidor recusou o refino."
			set_status(self, reason, COLOR_GOLD)
		end
	elseif message_id == hash("world_refinement_pending") then
		self.world_refinement_pending = true
		refresh_inventory_panel(self)
		set_status(self, "Aguardando o resultado do refino no servidor local.", COLOR_GOLD)
	elseif message_id == hash("world_refinement_rejected") then
		self.world_refinement_pending = false
		refresh_inventory_panel(self)
		set_status(self, message.text or "O refino não pôde ser enviado.", COLOR_GOLD)
	elseif message_id == hash("world_mounts_updated") then
		local decoded_ok, mount_state = pcall(json.decode, message.state_json or "")
		if not decoded_ok or type(mount_state) ~= "table" or type(mount_state.mounts) ~= "table" then
			self.world_mount_status_result = { status = 2, reason = 6 }
		else
			self.world_mount_snapshot_ready = true
			self.world_mounts = mount_state.mounts
			if message.completed then self.world_mount_pending = false end
			self.world_mount_status_result = { status = mount_state.status, reason = mount_state.reason }
			if #self.world_mounts == 0 then
				self.world_mount_selected_index = 1
			elseif not self.world_mounts[self.world_mount_selected_index or 1] then
				self.world_mount_selected_index = 1
				for index, mount in ipairs(self.world_mounts) do
					if mount.active then self.world_mount_selected_index = index; break end
				end
			end
		end
		refresh_mount_panel(self)
	elseif message_id == hash("world_mount_pending") then
		self.world_mount_pending = true
		set_text(self, self.world_mount_status, "Aguardando confirmação e gravação do servidor...")
		refresh_mount_panel(self)
	elseif message_id == hash("world_mount_rejected") then
		self.world_mount_pending = false
		self.world_mount_status_result = { status = 2, reason = 7 }
		refresh_mount_panel(self)
		set_status(self, message.text or "A ação da montaria foi recusada.", COLOR_GOLD)
	elseif message_id == hash("world_trade_updated") then
		local decoded_ok, trade_state = pcall(json.decode, message.state_json or "")
		if not decoded_ok or type(trade_state) ~= "table" then
			self.world_trade_local_message = "O estado de troca recebido está inválido."
		else
			self.world_trade_state = trade_state
			self.world_trade_local_message = nil
		end
		self.world_trade_pending = false
		refresh_trade_panel(self)
		if decoded_ok and trade_state and trade_state.status == "committed" then
			set_status(self, "Troca concluída e salva pelo servidor local.", COLOR_GOLD)
		elseif decoded_ok and trade_state and trade_state.status == "invited" and trade_state.trade and trade_state.trade.incoming then
			set_trade_panel_open(self, true)
			set_status(self, "Você recebeu um convite de troca.", COLOR_GOLD)
		end
	elseif message_id == hash("world_trade_pending") then
		self.world_trade_pending = true
		self.world_trade_local_message = "Aguardando resposta do servidor local..."
		refresh_trade_panel(self)
	elseif message_id == hash("world_trade_rejected") then
		self.world_trade_pending = false
		self.world_trade_local_message = message.text or "A ação de troca foi recusada."
		refresh_trade_panel(self)
	elseif message_id == hash("world_shop_updated") then
		local decoded_ok, shop_state = pcall(json.decode, message.state_json or "")
		if not decoded_ok or type(shop_state) ~= "table" or type(shop_state.listings) ~= "table" then
			self.world_shop_local_message = "O estado recebido da feira está inválido."
		else
			self.world_shop_state = shop_state
			self.world_shop_local_message = shop_state.message
			if shop_state.receipt then self.world_shop_receipt = shop_state.receipt end
		end
		self.world_shop_pending = false
		refresh_player_shop_panel(self)
		if decoded_ok and shop_state and shop_state.status == "ok" and shop_state.receipt then
			local item = CaracatoaItems.by_id[shop_state.receipt.clientItemId]
			set_status(self, string.format("Compra salva: %s por %s gold.", item and item.name or "item", tostring(shop_state.receipt.askingGold)), COLOR_GOLD)
			request_player_shop_action(self, "list")
		elseif decoded_ok and shop_state and shop_state.status == "ok" then
			set_status(self, shop_state.message or "Feira atualizada pelo servidor.", COLOR_GOLD)
		elseif decoded_ok and shop_state then
			set_status(self, shop_state.message or "O servidor recusou a operação do mercado.", COLOR_GOLD)
		end
	elseif message_id == hash("world_shop_pending") then
		self.world_shop_pending = true
		self.world_shop_local_message = "Aguardando o servidor Caracatoa confirmar..."
		refresh_player_shop_panel(self)
	elseif message_id == hash("world_shop_rejected") then
		self.world_shop_pending = false
		self.world_shop_local_message = message.text or "A operação do mercado foi recusada."
		refresh_player_shop_panel(self)
		set_status(self, self.world_shop_local_message, COLOR_GOLD)
	elseif message_id == hash("world_equipment_updated") then
		if message.status == 1 then
			set_text(self, self.world_equipment_status, "O servidor recusou a troca.")
			refresh_inventory_panel(self)
			set_status(self, "Equipamento não alterado.", COLOR_GOLD)
		else
			if message.status ~= 2 or message.snapshot_complete then
				self.world_equipment_ready = true
			end
			if (message.client_item_id or 0) == 0 then
				self.world_equipment[message.equipment_slot] = nil
			else
				self.world_equipment[message.equipment_slot] = {
					inventory_slot = message.inventory_slot,
					client_item_id = message.client_item_id,
				}
			end
			self.world_equipment_totals = {
				attack = message.total_attack_bonus or 0,
				defense = message.total_defense_bonus or 0,
			}
			refresh_inventory_panel(self)
			if message.status == 0 then set_status(self, "Equipamento confirmado e salvo pelo servidor.", COLOR_GOLD) end
		end
	elseif message_id == hash("world_equipment_pending") then
		set_text(self, self.world_equipment_status, "Aguardando confirmação do servidor...")
		set_skill_button_enabled(self.world_equipment_toggle_button, false)
	elseif message_id == hash("world_equipment_rejected") then
		set_text(self, self.world_equipment_status, message.text or "A troca de equipamento foi recusada.")
		refresh_inventory_panel(self)
	elseif message_id == hash("session_error") then
		self.login_pending = false
		local screen = message.screen or "login"
		set_screen(self, screen)
		set_status(self, message.text or "Não foi possível completar a sessão local.", COLOR_GOLD)
		if HUD_REGISTRATION_TEST_MODE then report_hud_registration_test(self, false, "session-error") end
	elseif message_id == hash("session_create_error") then
		set_screen(self, "create")
		set_status(self, message.text or "Não foi possível criar a personagem.", COLOR_GOLD)
		if HUD_ONBOARDING_TEST_MODE then report_hud_registration_test(self, false, "character-create-rejected") end
	end
end

function update(self, dt)
	update_world_combat_feedback(self, dt)
	if self.world_defense_remaining and self.world_defense_remaining > 0 then
		self.world_defense_remaining = math.max(0, self.world_defense_remaining - dt)
		if self.world_defense_remaining > 0 then
			set_text(self, self.world_skill_status, string.format("%s ativo: +%d DEF · %d s", self.world_defense_skill_name or "Guarda", self.world_defense_bonus or 0, math.ceil(self.world_defense_remaining)))
		else
			set_text(self, self.world_skill_status, (self.world_defense_skill_name or "Guarda") .. " expirou")
			self.world_defense_bonus = 0
		end
	end
end

function on_input(self, action_id, action)
	if self.screen == "world" and action_id == hash("camera_mode_cycle") and action.pressed then
		msg.post("/camera#preview_camera", "camera_mode_next")
		return true
	elseif self.screen == "world" and action_id == hash("camera_zoom_in") and action.value == 1 then
		msg.post("/camera#preview_camera", "camera_zoom", { delta = -1 })
		return true
	elseif self.screen == "world" and action_id == hash("camera_zoom_out") and action.value == 1 then
		msg.post("/camera#preview_camera", "camera_zoom", { delta = 1 })
		return true
	end
	if action_id == hash("text") then
		append_text(self, action.text)
		return true
	elseif action_id == hash("backspace") and action.pressed then
		local name = self.active_field
		if name then
			local value = self.values[name] or ""
			self.values[name] = value:sub(1, math.max(0, #value - 1))
			render_field(self, name)
			if name == "shop_price" then refresh_player_shop_panel(self) end
		end
		return true
	elseif action_id == hash("tab") and action.pressed then
		local available = {}
		for _, field in ipairs(self.fields) do
			local trade_field = field.name == "trade_target" or field.name == "trade_gold"
			local shop_field = field.name == "shop_price"
			if field.screen == self.screen and (not trade_field or self.trade_panel_open) and
				(not shop_field or self.shop_panel_open) then available[#available + 1] = field.name end
		end
		if #available > 0 then
			local next_index = 1
			for index, name in ipairs(available) do
				if name == self.active_field then next_index = index % #available + 1; break end
			end
			set_active_field(self, available[next_index])
		end
		return true
	elseif action_id == hash("enter") and action.pressed then
		submit_primary(self)
		return true
	elseif action.pressed and (action_id == hash("skill_slot_1") or action_id == hash("skill_slot_2") or action_id == hash("skill_slot_3")) then
		if self.screen == "world" then
			local slot = action_id == hash("skill_slot_1") and 1 or action_id == hash("skill_slot_2") and 2 or 3
			cast_skill_slot(self, slot)
			return true
		end
	elseif action_id == hash("escape") and action.pressed then
		if self.screen == "pin" then handle_button(self, "back_login")
		elseif self.screen == "register" then handle_button(self, "register_back")
		elseif self.screen == "create" then handle_button(self, "back_roster")
		elseif self.screen == "world" then handle_button(self, "logout") end
		return true
	elseif action_id == hash("click") then
		-- A short click can deliver press and release together after HTML5 wakes
		-- from its idle throttle. Dispatch once from the release phase, which has
		-- the final pointer position, and avoid stale press/release state.
		if action.released then return handle_mouse_click(self, action) end
	end
	return false
end
