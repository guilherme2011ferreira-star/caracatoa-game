}
local ACCESS_SCREENS = { login = true, register = true, pin = true, roster = true, create = true }
local IDLE_ACCESS_THROTTLE_SECONDS = 1.25
local HUD_ONBOARDING_TEST_MODE = os.getenv("CARACATOA_HUD_ONBOARDING_TEST") == "1"
local HUD_REGISTRATION_TEST_MODE = HUD_ONBOARDING_TEST_MODE or os.getenv("CARACATOA_HUD_REGISTRATION_TEST") == "1"

local function is_access_screen(screen)
	return ACCESS_SCREENS[screen] == true
end

local function set_access_idle_throttle(self)
	if not self.html5_preview then return end
	local should_throttle = (self.screen == "login" or self.screen == "register")
		and not self.login_pending and not self.registration_pending
	sys.set_engine_throttle(should_throttle, IDLE_ACCESS_THROTTLE_SECONDS)
end

local function track_node(self, screen, node)
	self.screen_nodes[screen][#self.screen_nodes[screen] + 1] = node
	return node
end

local function add_box(self, screen, x, y, width, height, color)
	local node = gui.new_box_node(vmath.vector3(x, y, 0.1), vmath.vector3(width, height, 0))
	gui.set_pivot(node, gui.PIVOT_CENTER)
	gui.set_color(node, color)
	return track_node(self, screen, node)
end

local function add_round_surface(self, screen, x, y, width, height, color, z, radius)
	z = z or 0.1
	radius = math.min(radius or 7, height / 2, width / 2)
	local nodes = {}
	local function add_piece(kind, px, py, sx, sy)
		local node
		if kind == "circle" then
			node = gui.new_pie_node(vmath.vector3(px, py, z), vmath.vector3(sx, sy, 0))
			gui.set_fill_angle(node, 360)
		else
			node = gui.new_box_node(vmath.vector3(px, py, z), vmath.vector3(sx, sy, 0))
		end
		gui.set_pivot(node, gui.PIVOT_CENTER)
		gui.set_color(node, color)
		nodes[#nodes + 1] = track_node(self, screen, node)
	end
	add_piece("box", x, y, width - radius * 2, height)
	add_piece("box", x, y, width, height - radius * 2)
	for _, side in ipairs({ -1, 1 }) do
		for _, vertical in ipairs({ -1, 1 }) do
			add_piece("circle", x + side * (width / 2 - radius), y + vertical * (height / 2 - radius), radius * 2, radius * 2)
		end
	end
	return { nodes = nodes }
end

local function set_surface_color(surface, color)
	for _, node in ipairs(surface.nodes or { surface }) do gui.set_color(node, color) end
end

local function set_surface_enabled(surface, enabled)
	for _, node in ipairs(surface.nodes or { surface }) do gui.set_enabled(node, enabled) end
end

local function hit_rect_contains(hit_rect, x, y)
	return hit_rect and type(x) == "number" and type(y) == "number" and
		x >= hit_rect.x - hit_rect.width / 2 and
		x <= hit_rect.x + hit_rect.width / 2 and
		y >= hit_rect.y - hit_rect.height / 2 and
		y <= hit_rect.y + hit_rect.height / 2
end

local function add_text(self, screen, x, y, value, color, centered, scale, z)
	local font = "cinzel"
	local text_z = z or 0.2
	local pivot = centered and gui.PIVOT_CENTER or gui.PIVOT_W
	local effects = {}
	if is_access_screen(screen) or screen == "create" or screen == "world" then


		local shadow = gui.new_text_node(vmath.vector3(x + 2, y - 2, text_z - 0.005), value)
		gui.set_font(shadow, font)
		gui.set_pivot(shadow, pivot)
		gui.set_color(shadow, COLOR_TEXT_SHADOW)
		if scale and scale ~= 1 then gui.set_scale(shadow, vmath.vector3(scale, scale, 1)) end
		track_node(self, screen, shadow)
		effects[#effects + 1] = { node = shadow, color = COLOR_TEXT_SHADOW }
	end
	local node = gui.new_text_node(vmath.vector3(x, y, text_z), value)
	gui.set_font(node, font)
	gui.set_pivot(node, pivot)
	gui.set_color(node, color or COLOR_TEXT)
	if scale and scale ~= 1 then gui.set_scale(node, vmath.vector3(scale, scale, 1)) end
	if #effects > 0 then
		self.text_shadow_by_node = self.text_shadow_by_node or {}
		self.text_shadow_by_node[node] = effects[1].node
	end
	return track_node(self, screen, node), effects
end

local function set_text(self, node, value)
	if not node then return end
	gui.set_text(node, value)
	local shadow = self.text_shadow_by_node and self.text_shadow_by_node[node]
	if shadow then gui.set_text(shadow, value) end
end

local function set_text_scale(self, node, scale)
	if not node then return end
	local size = vmath.vector3(scale, scale, 1)
	gui.set_scale(node, size)
	local shadow = self.text_shadow_by_node and self.text_shadow_by_node[node]
	if shadow then gui.set_scale(shadow, size) end
end

local function panel_is_open(self, panel)
	if not panel then return true end
	if panel == "attributes" or panel == "inventory" or panel == "skills" then
		return self.screen == "world" and self.world_detail_panel == panel
	elseif panel == "mount" then
		return self.screen == "world" and self.mount_panel_open == true
	elseif panel == "trade" then
		return self.screen == "world" and self.trade_panel_open == true
	elseif panel == "shop" then
		return self.screen == "world" and self.shop_panel_open == true
	end
	return false
end

local function capture_world_panel(self, name, first_node, first_button, first_field)
	self.world_panel_nodes = self.world_panel_nodes or {}
	local nodes = {}
	for index = first_node, #self.screen_nodes.world do
		nodes[#nodes + 1] = self.screen_nodes.world[index]
	end
	self.world_panel_nodes[name] = nodes
	for index = first_button, #self.buttons do
		local button = self.buttons[index]
		if button.screen == "world" then button.panel = name end
	end
	for index = first_field, #self.fields do
		local field = self.fields[index]
		if field.screen == "world" then field.panel = name end
	end
end

local function active_overlay_panel(self)
	if self.mount_panel_open then return "mount" end
	if self.trade_panel_open then return "trade" end
	if self.shop_panel_open then return "shop" end
	return nil
end

local function field_is_available(self, field)
	if field.panel then return panel_is_open(self, field.panel) end
	return self.screen ~= "world" or active_overlay_panel(self) == nil
end

local function button_is_available(self, button)
	if button.panel then return panel_is_open(self, button.panel) end
	local overlay = self.screen == "world" and active_overlay_panel(self) or nil
	if overlay then
		return button.action == "logout" or button.action:sub(-7) == "_toggle"
	end
	return true
end

local function truncate_utf8(value, max_characters)
	value = tostring(value or "")
	local byte_index = 1
	local character_count = 0
	local prefix_end = 0
	while byte_index <= #value and character_count < max_characters do
		local first = string.byte(value, byte_index)
		local width = first >= 240 and 4 or (first >= 224 and 3 or (first >= 192 and 2 or 1))
		prefix_end = math.min(#value, byte_index + width - 1)
		byte_index = byte_index + width
		character_count = character_count + 1
	end
	if byte_index <= #value then return value:sub(1, prefix_end) .. "…" end
	return value
end

